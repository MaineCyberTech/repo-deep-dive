@@ -115,6 +115,20 @@ class PruneTests(unittest.TestCase):
         self.assertEqual(state_left, 1)
         self.assertEqual(events_left, 1)
 
+    def test_prune_applies_audit_log_retention(self):
+        # DATA-P2-002: the append-only audit log is bounded by a long retention window.
+        old = iso(now() - timedelta(days=RETENTION_DAYS["audit_log"] + 1))
+        recent = iso(now() - timedelta(hours=1))
+        self.store.audit(old, "tester", "old.audit", "{}")
+        self.store.audit(recent, "tester", "recent.audit", "{}")
+        counts = self.store.prune(iso(now()))
+        self.assertEqual(counts["audit_log"], 1)
+        with self.store._lock:
+            actions = {r["action"] for r in
+                       self.store._db.execute("SELECT action FROM audit_log")}
+        self.assertIn("recent.audit", actions)
+        self.assertNotIn("old.audit", actions)
+
 
