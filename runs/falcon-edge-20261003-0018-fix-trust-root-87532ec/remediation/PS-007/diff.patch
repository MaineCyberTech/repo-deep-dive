+    def test_reopen_is_idempotent_and_reapplies_indexes(self):
+        # DATA-P2-003: opening an already-current DB is a no-op (the migration is
+        # idempotent), and the idempotent `CREATE INDEX IF NOT EXISTS` statements keep
+        # an existing DB in sync with indexes added after it was created.
+        tmp = tempfile.TemporaryDirectory(prefix="falcon-idem-")
+        path = os.path.join(tmp.name, "cp.db")
+        store = Store(path)
+        try:
+            sid = "fes_" + "a" * 24
+            add_sensor(store, sid)
+            store.set_desired_state(sid, 1, "{}", '"etag"', iso(now()))
+            # simulate a database created before the audit_log retention index existed
+            with store._lock:
+                store._db.execute("DROP INDEX IF EXISTS idx_audit_log_at")
+                store._db.commit()
+        finally:
+            store.close()
+
+        store2 = Store(path)
+        try:
+            self.assertEqual(store2._db.execute("PRAGMA user_version").fetchone()[0], SCHEMA_VERSION)
+            # rows survive the reopen unchanged (migration is a no-op at the current version)
+            self.assertEqual(store2._db.execute("SELECT COUNT(*) FROM sensors").fetchone()[0], 1)
+            self.assertEqual(
+                store2._db.execute("SELECT COUNT(*) FROM desired_state").fetchone()[0], 1)
+            # the index added after the DB was created is present again
+            self.assertIsNotNone(store2._db.execute(
+                "SELECT 1 FROM sqlite_master WHERE type='index' AND name='idx_audit_log_at'"
+            ).fetchone())
+        finally:
+            store2.close()
+            tmp.cleanup()
+
 
