diff --git a/.gitleaks.toml b/.gitleaks.toml
index 5ad4e43..8c34674 100644
--- a/.gitleaks.toml
+++ b/.gitleaks.toml
@@ -12,7 +12,7 @@
 [extend]
 useDefault = true
 
-[allowlist]
+[[allowlists]]
 description = "Reviewed-safe lab values (public keys, token ids)"
 regexTarget = "line"
 regexes = [
@@ -21,3 +21,18 @@ regexes = [
   'stripped: .[A-Za-z0-9+/=_-]{43,44}. len 43',
   'token_id:\s*[0-9a-fA-F-]{36}',
 ]
+
+# SC-P2-002: the validate workflow now scans full git history. Two historical
+# `generic-api-key` matches surfaced that were remediated in the tree but remain in
+# history: a synthetic redaction fixture literal in tests/phase0/test_capture_hardening.py
+# (removed in 74bdb09) and an Idempotency-Key comment in tests/phase3/test_agent_integration.py
+# (reworded in 5b1a09e). Both are attested false positives with no secret value. Scoped to
+# the exact commits AND the generic-api-key rule so any other finding in those commits, or any
+# finding in those files today, is still reported.
+[[allowlists]]
+description = "SC-P2-002 historical generic-api-key false positives, removed in-tree (74bdb09 / 5b1a09e)"
+commits = [
+  "a64c629866ce377e51b4124fab6d39b23c64ba79",
+  "37980608d7192292854231c2e611e45e32c261c2",
+]
+targetRules = ["generic-api-key"]
