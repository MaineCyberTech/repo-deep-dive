+class PeerRateLimiter:
+    """Fixed-window per-peer request limiter (SEC-P2-001).
+
+    Peers are keyed by the client-certificate fingerprint when one is present,
+    otherwise by source address. Expired windows are pruned lazily so the peer
+    map stays bounded.
+    """
+
+    def __init__(self, limit: int = DEFAULT_RATE_LIMIT,
+                 window: float = DEFAULT_RATE_WINDOW_SECONDS, max_peers: int = 4096):
+        self.limit = max(1, int(limit))
+        self.window = max(1.0, float(window))
+        self.max_peers = max(16, int(max_peers))
+        self._lock = threading.Lock()
+        self._peers: dict = {}
+
+    def allow(self, peer: str) -> bool:
+        now = time.monotonic()
+        with self._lock:
+            if len(self._peers) > self.max_peers:
+                self._prune(now)
+            start, count = self._peers.get(peer, (now, 0))
+            if now - start >= self.window:
+                start, count = now, 0
+            count += 1
+            self._peers[peer] = (start, count)
+            return count <= self.limit
+
+    def _prune(self, now: float) -> None:
+        self._peers = {p: v for p, v in self._peers.items()
+                       if now - v[0] < self.window}
+        if len(self._peers) > self.max_peers:
+            for peer, _ in sorted(self._peers.items(), key=lambda kv: kv[1][0]):
+                if len(self._peers) <= self.max_peers:
+                    break
+                self._peers.pop(peer, None)
+
 
