+    def test_over_capacity_connection_is_refused_with_503(self):
+        """ARCH-P3-001: with all slots taken, the next connection is shed, not threaded."""
+        httpd = BoundedThreadingHTTPServer(("127.0.0.1", 0), EdgeRequestHandler, max_workers=1)
+
+        class FakeConn:
+            def __init__(self):
+                self.sent = b""
+                self.closed = False
+
+            def sendall(self, data):
+                self.sent += data
+
+            def shutdown(self, how):
+                pass
+
+            def close(self):
+                self.closed = True
+
+        fake = FakeConn()
+        try:
+            self.assertTrue(httpd._slots.acquire(blocking=False))
+            httpd.process_request(fake, ("127.0.0.1", 12345))
+            self.assertIn(b"503", fake.sent)
+            self.assertIn(b"Connection: close", fake.sent)
+            self.assertTrue(fake.closed)
+        finally:
+            httpd.server_close()
