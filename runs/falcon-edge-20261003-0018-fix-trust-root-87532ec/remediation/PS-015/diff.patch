+# intentionally generous - the point is a bound, not a tight quota. Override
+# with FALCON_HTTP_RATE_LIMIT / FALCON_HTTP_RATE_WINDOW (seconds).
+DEFAULT_RATE_LIMIT = 1000
+DEFAULT_RATE_WINDOW_SECONDS = 10.0
