+class BoundedThreadingHTTPServer(ThreadingHTTPServer):
+    """ThreadingHTTPServer with a hard cap on concurrent request handlers.
+
+    A connection accepted beyond ``max_workers`` in-flight handlers is refused
+    with 503 instead of spawning another unbounded thread (ARCH-P3-001).
+    """
+
+    daemon_threads = True
+
+    def __init__(self, server_address, handler_cls, max_workers: int = DEFAULT_MAX_CONNECTIONS,
+                 rate_limiter: PeerRateLimiter | None = None):
+        self.max_workers = max(1, int(max_workers))
+        self.rate_limiter = rate_limiter or PeerRateLimiter()
+        self._slots = threading.BoundedSemaphore(self.max_workers)
+        super().__init__(server_address, handler_cls)
+
+    def process_request(self, request, client_address):
+        if not self._slots.acquire(blocking=False):
+            self._refuse_busy(request)
+            return
+        try:
+            super().process_request(request, client_address)
+        except Exception:
+            self._slots.release()
+            raise
+
+    def process_request_thread(self, request, client_address):
+        try:
+            super().process_request_thread(request, client_address)
+        finally:
+            self._slots.release()
+
+    def _refuse_busy(self, request) -> None:
+        body = json.dumps({
+            "type": "https://falcon.lab/problems/server_busy",
+            "title": "Too many concurrent connections",
+            "status": 503,
+            "code": "SERVER_BUSY",
+            "retryable": True,
+        }).encode("utf-8")
+        try:
+            request.sendall(
+                b"HTTP/1.1 503 Service Unavailable\r\n"
+                b"Content-Type: application/problem+json\r\n"
+                b"Retry-After: 1\r\n"
+                b"Connection: close\r\n"
+                b"Cache-Control: no-store\r\n"
+                + ("Content-Length: %d\r\n\r\n" % len(body)).encode()
+                + body)
+        except OSError:
+            pass
+        finally:
+            self.shutdown_request(request)
+
