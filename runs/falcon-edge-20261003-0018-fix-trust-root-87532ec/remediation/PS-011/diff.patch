+#!/usr/bin/env python3
+"""Guard committed point-in-time derived artifacts against silent drift.
+
+Findings HYG-P2-002 / INV-P3-001: several derived artifacts are committed without a
+regeneration/`--check` guard. `closeout/generate_final_response.py --check` covers
+FINAL_RESPONSE.json against its source of truth (ledgers/gate_ledger.csv). This script
+covers the artifacts that have no generator: the Grafana dashboard and the frozen audit
+mirror. They are pinned by content SHA-256 in `closeout/derived_artifacts.json`, so an
+edit or regeneration that was not intentionally accompanied by a manifest update makes
+`ci/validate.sh` fail.
+
+Usage:
+    check_derived.py    verify every pinned artifact matches its recorded digest (exit 1 on drift)
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import sys
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+MANIFEST = os.path.join(REPO, "closeout", "derived_artifacts.json")
+
+
+def file_sha256(path: str) -> str:
+    """SHA-256 of the artifact's text content with CRLF normalised to LF.
+
+    The pinned artifacts are text (JSON / Markdown / HTML). Normalising line endings keeps
+    the digest stable across a normal checkout and a `git archive` export even when a
+    historical blob predates the repository's ``eol=lf`` policy.
+    """
+    digest = hashlib.sha256()
+    with open(path, "rb") as fh:
+        digest.update(fh.read().replace(b"\r\n", b"\n"))
+    return digest.hexdigest()
+
+
+def tree_sha256(root: str) -> str:
+    """SHA-256 over the sorted (relative path, content digest) pairs under ``root``.
+
+    Line-ending policy is LF-only in the repository (see .gitattributes), so hashing the
+    working-tree bytes is stable across checkouts.
+    """
+    digest = hashlib.sha256()
+    for dirpath, dirnames, filenames in os.walk(root):
+        dirnames.sort()
+        for name in sorted(filenames):
+            absolute = os.path.join(dirpath, name)
+            relative = os.path.relpath(absolute, root).replace(os.sep, "/")
+            digest.update(relative.encode("utf-8"))
+            digest.update(b"\0")
+            digest.update(file_sha256(absolute).encode("ascii"))
+            digest.update(b"\n")
+    return digest.hexdigest()
+
+
+def main() -> int:
+    with open(MANIFEST, encoding="utf-8") as fh:
+        manifest = json.load(fh)
+
+    failures = 0
+    frozen_at = (manifest.get("frozen_at_commit") or "?")[:12]
+    for entry in manifest.get("artifacts", []):
+        target = os.path.join(REPO, entry["path"])
+        if not os.path.isfile(target):
+            print(f"FAIL derived artifact missing: {entry['path']}")
+            failures += 1
+            continue
+        actual = file_sha256(target)
+        expected = entry["sha256"]
+        if actual != expected:
+            print(f"FAIL derived artifact drifted: {entry['path']}")
+            print(f"     expected {expected}")
+            print(f"     actual   {actual}")
+            failures += 1
+        else:
+            print(f"PASS {entry['path']} frozen at {frozen_at}")
+
+    for entry in manifest.get("directories", []):
+        target = os.path.join(REPO, entry["path"])
+        if not os.path.isdir(target):
+            print(f"FAIL derived directory missing: {entry['path']}")
+            failures += 1
+            continue
+        actual = tree_sha256(target)
+        expected = entry["tree_sha256"]
+        if actual != expected:
+            print(f"FAIL derived directory drifted: {entry['path']}")
+            print(f"     expected tree {expected}")
+            print(f"     actual   tree {actual}")
+            failures += 1
+        else:
+            print(f"PASS {entry['path']} frozen at {frozen_at}")
+
+    if failures:
+        print(f"derived-artifact guard: {failures} failure(s); update "
+              f"closeout/derived_artifacts.json only when the artifact is intentionally regenerated")
+        return 1
+    print("derived-artifact guard: all pinned artifacts match")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
