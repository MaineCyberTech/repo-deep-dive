@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Regression tests for committed derived-artifact guards (HYG-P2-002 / INV-P3-001).
+
+Locks the two guards wired into ci/validate.sh: FINAL_RESPONSE.json against its source of
+truth (ledgers/gate_ledger.csv), and the pinned dashboard / frozen-audit-mirror digests.
+"""
+import importlib.util
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+CHECK_DERIVED = os.path.join(REPO, "closeout", "check_derived.py")
+GEN_FINAL = os.path.join(REPO, "closeout", "generate_final_response.py")
+
+
+def load_check_derived():
+    spec = importlib.util.spec_from_file_location("check_derived", CHECK_DERIVED)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class GuardInvocationTests(unittest.TestCase):
+    def test_final_response_check_passes(self):
+        result = subprocess.run([sys.executable, GEN_FINAL, "--check"], cwd=REPO,
+                                capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("in sync", result.stdout)
+
+    def test_derived_artifact_check_passes(self):
+        result = subprocess.run([sys.executable, CHECK_DERIVED], cwd=REPO,
+                                capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("all pinned artifacts match", result.stdout)
+
+
+class TreeDigestTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="falcon-edge-tree-")
+        self.mod = load_check_derived()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp, ignore_errors=True)
+
+    def test_tree_digest_is_stable_and_detects_change(self):
+        os.makedirs(os.path.join(self.tmp, "sub"))
+        with open(os.path.join(self.tmp, "a.txt"), "w") as fh:
+            fh.write("one\n")
+        with open(os.path.join(self.tmp, "sub", "b.txt"), "w") as fh:
+            fh.write("two\n")
+        first = self.mod.tree_sha256(self.tmp)
+        self.assertEqual(first, self.mod.tree_sha256(self.tmp))
+        with open(os.path.join(self.tmp, "sub", "b.txt"), "a") as fh:
+            fh.write("edit\n")
+        self.assertNotEqual(first, self.mod.tree_sha256(self.tmp))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
