    def test_cycle_purges_expired_queue_items(self):
        """DATA-P3-001: age-expiry is enforced every cycle, without a new enqueue.
    
        Before the fix `purge_expired` was only reachable from tests, so a queue that
        stopped receiving work retained items past max_age_seconds. The cycle must purge
        the stale item before `read_batch`/`flush_queue` can deliver it.
        """
        agent = self.agent("agent-purge")
        agent.bootstrap(self.make_token())
        agent.queue.enqueue("event", {"stale": True})
