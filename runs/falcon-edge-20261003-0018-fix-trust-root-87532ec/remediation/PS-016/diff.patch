@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Regression test for the evidence size budget gate (INV-P2-001).
+
+The gate must be fail-closed: an over-budget evidence tree must make the checker return
+non-zero (so `ci/validate.sh` blocks and completed-phase captures get archived), while an
+under-budget tree passes.
+"""
+import importlib.util
+import os
+import tempfile
+import unittest
+
+REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+SCRIPT = os.path.join(REPO, "ci", "check_evidence_size.py")
+VALIDATE = os.path.join(REPO, "ci", "validate.sh")
+
+
+def _load_module():
+    spec = importlib.util.spec_from_file_location("check_evidence_size", SCRIPT)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _make_tree(root, n):
+    raw = os.path.join(root, "evidence", "raw")
+    os.makedirs(raw, exist_ok=True)
+    for i in range(n):
+        with open(os.path.join(raw, f"f{i}.txt"), "w", encoding="utf-8") as fh:
+            fh.write("x")
+
+
+class EvidenceBudgetGateTests(unittest.TestCase):
+    def setUp(self):
+        self.mod = _load_module()
+        # Keep the fixture tiny; the gate logic is the same as the real 2,500-file budget.
+        self.mod.BUDGET_FILES = 3
+        self.mod.BUDGET_MIB = 50
+
+    def test_under_budget_passes(self):
+        with tempfile.TemporaryDirectory() as root:
+            _make_tree(root, 2)
+            self.assertEqual(self.mod.main(["--root", root]), 0)
+
+    def test_over_budget_fails_closed(self):
+        with tempfile.TemporaryDirectory() as root:
+            _make_tree(root, 4)
+            self.assertEqual(self.mod.main(["--root", root]), 1)
+
+    def test_validate_wires_the_gate_fail_closed(self):
+        with open(VALIDATE, encoding="utf-8") as fh:
+            text = fh.read()
+        self.assertIn("python3 ci/check_evidence_size.py || rc=1", text)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
