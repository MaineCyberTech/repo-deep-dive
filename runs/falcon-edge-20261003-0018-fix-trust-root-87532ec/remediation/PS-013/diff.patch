+    def test_sensor_list_pagination_and_limit_validation(self):
+        # API-P2-002: keyset pagination; a negative limit must not bypass the page cap.
+        for name in ("page-a", "page-b", "page-c"):
+            self.enroll(name)
+        seen, cursor, pages = [], None, 0
+        while pages < 10:
+            path = "/api/v1/sensors?limit=2" + (f"&cursor={cursor}" if cursor else "")
+            status, _, obj = self.japi("GET", path, self.op_ctx)
+            self.assertEqual(status, 200, obj)
+            seen += [s["sensorId"] for s in obj["items"]]
+            pages += 1
+            cursor = obj.get("nextCursor")
+            if not cursor:
+                break
+        self.assertGreaterEqual(len(seen), 3)
+        self.assertEqual(len(seen), len(set(seen)), "pagination must not repeat sensors")
+        for bad in ("0", "-1", "501", "abc"):
+            status, _, obj = self.japi("GET", f"/api/v1/sensors?limit={bad}", self.op_ctx)
+            self.assertEqual(400, status, (bad, obj))
+            self.assertEqual(obj["code"], "INVALID_LIMIT")
+
+    def test_malformed_csr_does_not_burn_token(self):
+        # API-P2-004: a bad body must not destroy a single-use bootstrap token, and the
+        # rejection is an RFC 9457 problem, not a transport error.
+        token = self.make_token()
+        bogus = {
+            "schemaVersion": "1.0",
+            "deviceUuid": str(uuid.uuid4()),
+            "csrPem": ("-----BEGIN CERTIFICATE REQUEST-----\n" + "A" * 128
+                       + "\n-----END CERTIFICATE REQUEST-----\n"),
+            "nonce": "n" * 32,
+            "hardware": {"model": "Raspberry Pi 3 Model B", "architecture": "arm64",
+                         "memoryMb": 1024},
+            "agent": {"version": "0.1.0", "apiVersion": "v1", "schemaVersion": "1.0"},
+        }
+        status, _, obj = self.japi("POST", "/api/v1/enrollments", self.noauth_ctx, bogus,
+                                   {"Authorization": "Bearer " + token["token"]})
+        self.assertEqual(400, status, obj)
+        self.assertEqual(obj["code"], "CSR_INVALID")
+        self.assertFalse(obj["retryable"])
+        # the token survived the bad body: a valid enrollment with it still succeeds
+        _, ctx, _, _ = self.enroll("csr-retry", token=token)
+        status, _, _ = self.japi("GET", "/api/v1/healthz", ctx)
+        self.assertEqual(status, 200)
+
