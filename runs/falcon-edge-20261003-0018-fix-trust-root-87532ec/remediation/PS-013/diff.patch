+            rows = self._db.execute(
+                f"SELECT * FROM sensors{where} ORDER BY sensor_id LIMIT ?",
+                (*params, limit)).fetchall()
         return rows
 
+    def list_sensors_page(self, state: str | None = None, limit: int = 100,
+                          after: str | None = None):
+        """Keyset page: returns (rows, next_cursor). Fetches one extra row to know
+        whether another page exists (API-P2-002)."""
+        rows = self.list_sensors(state, limit + 1, after)
+        next_cursor = None
+        if len(rows) > limit:
+            rows = rows[:limit]
+            next_cursor = rows[-1]["sensor_id"]
+        return rows, next_cursor
+
     def update_sensor(self, sensor_id: str, **fields) -> None:
