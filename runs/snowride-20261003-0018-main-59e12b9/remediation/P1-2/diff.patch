+#!/usr/bin/env node
+// Branch protection as code (audit finding CI-P1-001).
+//
+// `main` must not accept a merge without a human review and the ci-foundation
+// checks (`foundation`, `migrations`, `e2e`). GitHub enforces that server-side;
+// this file keeps the declared policy (.github/branch-protection.json) honest,
+// proves its required checks match the workflow's real job names, and
+// audits/exports the live setting for evidence.
+//
+// Usage:
+//   node scripts/verify-branch-protection.mjs --self-test
+//   node scripts/verify-branch-protection.mjs --print-expected
+//   GITHUB_TOKEN=... GITHUB_REPOSITORY=owner/repo \
+//     node scripts/verify-branch-protection.mjs
+import { readFileSync } from "node:fs";
+import { dirname, resolve } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+
+const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const POLICY_PATH = resolve(ROOT, ".github/branch-protection.json");
+const WORKFLOW_PATH = resolve(ROOT, ".github/workflows/ci-foundation.yml");
+const API = "https://api.github.com";
+
+export function loadPolicy(path = POLICY_PATH) {
+  return JSON.parse(readFileSync(path, "utf8"));
+}
+
+// Job ids are the two-space-indented keys directly under the workflow's
+// top-level `jobs:` block; `steps` and deeper keys are indented further.
+export function workflowJobNames(path = WORKFLOW_PATH) {
+  const jobs = [];
+  let inJobs = false;
+  for (const line of readFileSync(path, "utf8").split(/\r?\n/)) {
+    if (/^jobs:\s*$/.test(line)) {
+      inJobs = true;
+      continue;
+    }
+    if (!inJobs) continue;
+    if (/^\S/.test(line)) break; // next top-level key
+    const job = /^ {2}([A-Za-z0-9_-]+):\s*$/.exec(line);
+    if (job) jobs.push(job[1]);
+  }
+  return jobs;
+}
+
+export function validatePolicy(policy, jobNames) {
+  const errors = [];
+  if (!policy || typeof policy !== "object") return ["policy is not an object"];
+  if (!policy.branch) errors.push("branch is required");
+
+  const checks = policy.requiredStatusChecks;
+  if (
+    !checks ||
+    !Array.isArray(checks.contexts) ||
+    checks.contexts.length === 0
+  ) {
+    errors.push("requiredStatusChecks.contexts must list at least one check");
+  } else {
+    if (checks.strict !== true) {
+      errors.push(
+        "requiredStatusChecks.strict must be true (branches up to date)",
+      );
+    }
+    if (jobNames) {
+      const missing = checks.contexts.filter((c) => !jobNames.includes(c));
+      if (missing.length) {
+        errors.push(
+          `required checks missing from workflow jobs: ${missing.join(", ")}`,
+        );
+      }
+    }
+  }
+
+  const review = policy.requiredPullRequestReviews;
+  if (!review || !(review.requiredApprovingReviewCount >= 1)) {
+    errors.push(
+      "requiredPullRequestReviews.requiredApprovingReviewCount must be >= 1",
+    );
+  }
+  if (policy.requiredConversationResolution !== true) {
+    errors.push("requiredConversationResolution must be true");
+  }
+  if (policy.allowForcePushes !== false)
+    errors.push("allowForcePushes must be false");
+  if (policy.allowDeletions !== false)
+    errors.push("allowDeletions must be false");
+  return errors;
+}
+
+// Map the declared policy to GitHub's classic branch-protection payload.
+export function expectedProtection(policy) {
+  return {
+    required_status_checks: {
+      strict: policy.requiredStatusChecks.strict,
+      contexts: policy.requiredStatusChecks.contexts,
+    },
+    enforce_admins: Boolean(policy.enforceAdmins),
+    required_pull_request_reviews: {
+      dismiss_stale_reviews: Boolean(
+        policy.requiredPullRequestReviews.dismissStaleReviews,
+      ),
+      require_code_owner_reviews: Boolean(
+        policy.requiredPullRequestReviews.requireCodeOwnerReviews,
+      ),
+      required_approving_review_count:
+        policy.requiredPullRequestReviews.requiredApprovingReviewCount,
+    },
+    required_conversation_resolution: Boolean(
+      policy.requiredConversationResolution,
+    ),
+    allow_force_pushes: Boolean(policy.allowForcePushes),
+    allow_deletions: Boolean(policy.allowDeletions),
+  };
+}
+
+// Audit a GitHub branch-protection API response against the declared policy.
+export function auditLiveProtection(live, policy) {
+  if (!live || typeof live !== "object") {
+    return ["no branch protection is configured"];
+  }
+  const errors = [];
+  const want = policy.requiredStatusChecks.contexts;
+  const contexts = live.required_status_checks?.contexts ?? [];
+  const missing = want.filter((c) => !contexts.includes(c));
+  if (missing.length) {
+    errors.push(`live required checks missing: ${missing.join(", ")}`);
+  }
+  if (live.required_status_checks?.strict !== true) {
+    errors.push(
+      "live required checks are not strict (branches may be out of date)",
+    );
+  }
+  const count =
+    live.required_pull_request_reviews?.required_approving_review_count ?? 0;
+  if (count < policy.requiredPullRequestReviews.requiredApprovingReviewCount) {
+    errors.push("live PR review requirement is weaker than declared");
+  }
+  if (live.required_conversation_resolution?.enabled !== true) {
+    errors.push("live conversation resolution is not required");
+  }
+  if (live.allow_force_pushes?.enabled !== false) {
+    errors.push("live force pushes are allowed");
+  }
+  if (live.allow_deletions?.enabled !== false) {
+    errors.push("live deletions are allowed");
+  }
+  return errors;
+}
+
+async function fetchLiveProtection(token, repo, branch) {
+  const res = await fetch(
+    `${API}/repos/${repo}/branches/${branch}/protection`,
+    {
+      headers: {
+        authorization: `Bearer ${token}`,
+        accept: "application/vnd.github+json",
+        "x-github-api-version": "2022-11-28",
+      },
+    },
+  );
+  if (res.status === 404) return null;
+  if (!res.ok) throw new Error(`GitHub API ${res.status} ${res.statusText}`);
+  return res.json();
+}
+
+async function main(argv) {
+  const policy = loadPolicy();
+  if (argv.includes("--print-expected")) {
+    console.log(JSON.stringify(expectedProtection(policy), null, 2));
+    return 0;
+  }
+
+  const jobNames = workflowJobNames();
+  const errors = validatePolicy(policy, jobNames);
+  console.log(
+    `branch-protection policy: branch=${policy.branch} ` +
+      `checks=${policy.requiredStatusChecks.contexts.join(",")} ` +
+      `workflow_jobs=${jobNames.join(",")}`,
+  );
+  if (errors.length) {
+    for (const e of errors) console.error(`FAIL ${e}`);
+  } else {
+    console.log("PASS policy is complete and matches ci-foundation jobs");
+  }
+
+  const token = process.env.GITHUB_TOKEN;
+  const repo = process.env.GITHUB_REPOSITORY;
+  if (argv.includes("--self-test") || !token || !repo) {
+    if (!argv.includes("--self-test")) {
+      console.log(
+        "no GITHUB_TOKEN/GITHUB_REPOSITORY: skipped live audit (self-test only)",
+      );
+    }
+    return errors.length ? 1 : 0;
+  }
+
+  const live = await fetchLiveProtection(token, repo, policy.branch);
+  const liveErrors = auditLiveProtection(live, policy);
+  for (const e of liveErrors) console.error(`FAIL live ${e}`);
+  console.log(
+    liveErrors.length
+      ? "FAIL live branch protection does not match policy"
+      : "PASS live branch protection matches policy",
+  );
+  return errors.length || liveErrors.length ? 1 : 0;
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? "").href) {
+  main(process.argv.slice(2))
+    .then((code) => process.exit(code))
+    .catch((err) => {
+      console.error(`error: ${err.message}`);
+      process.exit(1);
+    });
+}
