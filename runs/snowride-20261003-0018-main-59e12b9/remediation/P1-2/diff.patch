new file mode 100644
index 0000000..45e200e
--- /dev/null
+++ b/tests/branch-protection.test.ts
@@ -0,0 +1,71 @@
+import { describe, expect, it } from "vitest";
+import {
+  auditLiveProtection,
+  expectedProtection,
+  loadPolicy,
+  validatePolicy,
+  workflowJobNames,
+} from "../scripts/verify-branch-protection.mjs";
+
+/**
+ * CI-P1-001: branch protection must be declared as code and stay consistent
+ * with the ci-foundation jobs that GitHub is asked to require on `main`.
+ * `foundation` runs this suite, so a change cannot silently weaken the policy.
+ */
+describe("branch protection policy", () => {
+  const policy = loadPolicy();
+  const jobs = workflowJobNames();
+
+  it("declares a review and the ci-foundation checks and passes validation", () => {
+    expect(validatePolicy(policy, jobs)).toEqual([]);
+    expect(policy.requiredStatusChecks.contexts).toEqual(
+      expect.arrayContaining(["foundation", "migrations", "e2e"]),
+    );
+  });
+
+  it("requires exactly the jobs that ci-foundation defines", () => {
+    expect([...policy.requiredStatusChecks.contexts].sort()).toEqual(
+      [...jobs].sort(),
+    );
+  });
+
+  it("rejects a policy whose required check is not a workflow job", () => {
+    const tampered = structuredClone(policy);
+    tampered.requiredStatusChecks.contexts = ["foundation", "not-a-job"];
+    expect(validatePolicy(tampered, jobs).join(" ")).toContain("not-a-job");
+  });
+
+  it("rejects a policy that drops the review requirement", () => {
+    const tampered = structuredClone(policy);
+    tampered.requiredPullRequestReviews.requiredApprovingReviewCount = 0;
+    expect(validatePolicy(tampered, jobs).length).toBeGreaterThan(0);
+  });
+
+  it("maps the declared policy to GitHub's protection payload", () => {
+    const payload = expectedProtection(policy);
+    expect(payload.required_status_checks.strict).toBe(true);
+    expect(payload.required_status_checks.contexts).toEqual(
+      policy.requiredStatusChecks.contexts,
+    );
+    expect(payload.allow_force_pushes).toBe(false);
+  });
+
+  it("audits the live setting: pass when compliant, fail closed when missing", () => {
+    const live = {
+      required_status_checks: { strict: true, contexts: [...jobs] },
+      required_pull_request_reviews: { required_approving_review_count: 1 },
+      required_conversation_resolution: { enabled: true },
+      allow_force_pushes: { enabled: false },
+      allow_deletions: { enabled: false },
+    };
+    expect(auditLiveProtection(live, policy)).toEqual([]);
+    expect(auditLiveProtection(null, policy)).toEqual([
+      "no branch protection is configured",
+    ]);
+
+    const weak = structuredClone(live);
+    weak.allow_force_pushes.enabled = true;
+    weak.required_pull_request_reviews.required_approving_review_count = 0;
+    expect(auditLiveProtection(weak, policy).length).toBeGreaterThanOrEqual(2);
+  });
+});
