diff --git a/.github/workflows/supply-chain.yml b/.github/workflows/supply-chain.yml
new file mode 100644
index 0000000..66fb661
--- /dev/null
+++ b/.github/workflows/supply-chain.yml
@@ -0,0 +1,64 @@
+# SUPPLY-P2-001: merge-gating supply-chain checks.
+#
+# The license allow-list and the production vulnerability/provenance checks used
+# to run only on the daily host lane (scripts/assurance/assurance.sh), so a
+# disallowed license or a high-severity advisory could reach `main` and ship
+# before the next scheduled run. This workflow runs the same gates on the pull
+# request that changes the dependency graph.
+#
+# It is deliberately ADDITIVE: it does not edit the foundation/migrations/e2e
+# jobs in ci-foundation.yml, so it does not conflict with the SBOM step
+# (SUPPLY-P1-001 / P1-3) or the pinned-secret-scan work (CI-P2-001/002).
+name: supply-chain
+on:
+  pull_request:
+    paths:
+      - package.json
+      - package-lock.json
+      - scripts/license-assurance.mjs
+      - .github/workflows/supply-chain.yml
+  push:
+    paths:
+      - package.json
+      - package-lock.json
+
+permissions:
+  contents: read
+
+jobs:
+  license-and-vulnerability:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0 (pin: CI-P2-002)
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0 (pin: CI-P2-002)
+        with:
+          node-version: 24
+          cache: npm
+      - run: npm ci
+      - name: license assurance (production dependency allow-list) (SUPPLY-P2-001)
+        # Blocking. Offline gate over the installed production tree; exits 1 on
+        # an unknown/prohibited/missing license. Same script the daily host lane
+        # runs, now merge-gating.
+        run: node scripts/license-assurance.mjs
+      - name: production dependency audit (SUPPLY-P2-001)
+        # Advisory (non-blocking) at the current base: the production tree has
+        # one high advisory in the transitive runtime dep @grpc/grpc-js
+        # (GHSA-m9gg-hp2v-232j / GHSA-f596-whhp-79r4). Blocking here would make
+        # every PR red; clearing it needs a lockfile dependency bump outside
+        # this patch set (see PR open questions). The daily host lane already
+        # reports it. License enforcement above is the blocking gate that was
+        # previously missing.
+        continue-on-error: true
+        run: npm audit --omit=dev --audit-level=high
+      - name: registry signature verification (SUPPLY-P2-002)
+        # Advisory at the current base: `npm audit signatures` reports
+        # @playwright/test@1.63.0 "has attestations but no corresponding public
+        # key(s) can be found" (EMISSINGSIGNATUREKEY), so a blocking step would
+        # red every PR. The check is still run and surfaces the drift; resolving
+        # it is tracked in the PR open questions. The install-script allowlist
+        # and provenance policy are documented in docs/SUPPLY_CHAIN.md.
+        continue-on-error: true
+        run: npm audit signatures
