+  /**
+   * SEC-P2-001: browser-facing anonymous endpoints must not be drivable from an
+   * arbitrary cross-origin page. A request is admissible when it carries no
+   * `Origin` (curl, server-to-server, health probes), when the `Origin` is
+   * same-origin with the request `Host`, or when it is listed in
+   * `ALLOWED_ORIGINS`. Browser `Origin` cannot be forged by page script, so an
+   * absent or same-host value is trustworthy for this purpose.
+   */
+  private originAllowed(req: http.IncomingMessage): boolean {
+    const origin = req.headers.origin;
+    if (!origin) return true;
+    if (this.deps.config.allowedOrigins.includes(origin)) return true;
+    try {
+      if (req.headers.host && new URL(origin).host === req.headers.host) {
+        return true;
+      }
+    } catch {
+      return false;
+    }
+    return false;
+  }
+
+  /**
+   * SEC-P2-001: allow an admissible `Origin` (echoing it with `Vary: Origin`
+   * so shared caches stay safe) or reject a disallowed one with 403 before the
+   * handler reads any body. Returns true when the request was already answered.
+   */
+  private rejectDisallowedOrigin(
+    req: http.IncomingMessage,
+    res: http.ServerResponse,
+  ): boolean {
+    const origin = req.headers.origin;
+    if (!origin) return false;
+    if (this.originAllowed(req)) {
+      res.setHeader("access-control-allow-origin", origin);
+      res.setHeader("vary", "Origin");
+      return false;
+    }
+    res.writeHead(403, {
+      "content-type": "application/json",
+      vary: "Origin",
+    });
+    res.end(JSON.stringify({ ok: false, error: "origin_forbidden" }));
+    return true;
+  }
+
