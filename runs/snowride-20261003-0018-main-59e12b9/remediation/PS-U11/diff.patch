index 0000000..632058e
--- /dev/null
+++ b/.githooks/pre-commit
@@ -0,0 +1,28 @@
+#!/bin/sh
+# SEC-P2-002: repository-tree secret scan at commit time.
+#
+# CI scans the whole working tree on every PR (the pinned gitleaks step in
+# .github/workflows/ci-foundation.yml). This hook adds the local pre-commit
+# half so a secret never enters a commit in the first place. It scans only the
+# staged index (`gitleaks protect --staged`), so unrelated working-tree edits
+# are not blocked, and it redacts any match before printing it.
+#
+# Enable once per clone:
+#   git config core.hooksPath .githooks
+#
+# Fail closed when gitleaks is installed. When it is not, print a notice and
+# allow the commit: CI still performs the authoritative tree scan. Install
+# gitleaks for local enforcement.
+set -eu
+
+if ! command -v gitleaks >/dev/null 2>&1; then
+  echo "pre-commit: gitleaks not found; skipping local secret scan (CI scans the tree)" >&2
+  exit 0
+fi
+
+# Nothing staged -> nothing to scan (also avoids gitleaks' empty-diff noise).
+if git diff --cached --quiet; then
+  exit 0
+fi
+
+exec gitleaks protect --staged --redact --no-banner --verbose
