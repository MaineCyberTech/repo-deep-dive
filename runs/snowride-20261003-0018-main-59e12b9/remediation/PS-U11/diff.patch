+import { describe, it, expect, afterEach } from "vitest";
+import { createServer } from "node:net";
+import type { AddressInfo } from "node:net";
+import { RealtimeServer } from "../server.js";
+import { RoomManager } from "../rooms.js";
+import type { RealtimeConfig } from "../config.js";
+import type { JwtVerifier } from "../auth.js";
+
+// SEC-P2-001: the anonymous, browser-facing HTTP ingest endpoints (`/perf` and
+// `/client-error`) must reject a cross-origin `Origin` that is neither
+// same-origin with the request Host nor listed in ALLOWED_ORIGINS, while
+// still accepting non-browser callers (no Origin) and the configured origin.
+
+const silentLogger = {
+  info: () => {},
+  error: () => {},
+  warn: () => {},
+  debug: () => {},
+  fatal: () => {},
+  trace: () => {},
+  child: () => ({}) as never,
+  silent: undefined as never,
+} as never;
+
+const fakeVerifier = {
+  verify: async () => {
+    throw new Error("not used in origin tests");
+  },
+} as unknown as JwtVerifier;
+
+const config: RealtimeConfig = {
+  bindHost: "127.0.0.1",
+  port: 0,
+  allowedOrigins: ["https://app.snowride.invalid"],
+  rateLimitPingPerMin: 60,
+  rateLimitMovePerSec: 30,
+  supabaseUrl: "http://127.0.0.1:54321",
+  supabaseServiceKey: "unused",
+} as unknown as RealtimeConfig;
+
+const perfSample = {
+  v: 1,
+  platform: {
+    tier: "mid",
+    cores: 4,
+    memGb: 4,
+    webgl: true,
+    touch: false,
+    dpr: 1,
+    width: 1280,
+    height: 720,
+  },
+  quality: "high",
+  biome: "snowboard",
+  length: "standard",
+  reducedMotion: false,
+  frames: 300,
+  p50Ms: 33.3,
+  p95Ms: 50,
+  maxMs: 120,
+  longFrames: 2,
+  bootMs: 1500,
+  errors: 0,
+};
+
+const clientError = {
+  v: 1,
+  fingerprint: "0123456789abcdef",
+  frame: "SnowboardScene.ts:12",
+  count: 1,
+};
+
+function freePort(): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const srv = createServer();
+    srv.on("error", reject);
+    srv.listen(0, "127.0.0.1", () => {
+      const port = (srv.address() as AddressInfo).port;
+      srv.close(() => resolve(port));
+    });
+  });
+}
+
+async function startServer(): Promise<{ server: RealtimeServer; url: string }> {
+  const server = new RealtimeServer({
+    config,
+    verifier: fakeVerifier,
+    logger: silentLogger,
+    rooms: new RoomManager(64),
+    serviceClient: null,
+  });
+  const port = await freePort();
+  await server.start(port, "127.0.0.1");
+  return { server, url: `http://127.0.0.1:${port}` };
+}
+
+const servers: RealtimeServer[] = [];
+afterEach(async () => {
+  await Promise.all(servers.splice(0).map((s) => s.stop()));
+});
+
+function post(url: string, path: string, body: unknown, origin?: string) {
+  return fetch(`${url}${path}`, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      ...(origin ? { origin } : {}),
+    },
+    body: JSON.stringify(body),
+  });
+}
+
+describe("SEC-P2-001 HTTP Origin allowlist", () => {
+  it("rejects a disallowed cross-origin Origin on /perf and /client-error", async () => {
+    const { server, url } = await startServer();
+    servers.push(server);
+    const evil = "https://evil.example";
+
+    const perf = await post(url, "/perf", perfSample, evil);
+    expect(perf.status).toBe(403);
+    expect(await perf.json()).toEqual({
+      ok: false,
+      error: "origin_forbidden",
+    });
+
+    const beacon = await post(url, "/client-error", clientError, evil);
+    expect(beacon.status).toBe(403);
+    expect(await beacon.json()).toEqual({
+      ok: false,
+      error: "origin_forbidden",
+    });
+  });
+
+  it("accepts the configured ALLOWED_ORIGINS origin and echoes it for CORS", async () => {
+    const { server, url } = await startServer();
+    servers.push(server);
+    const allowed = "https://app.snowride.invalid";
+
+    const perf = await post(url, "/perf", perfSample, allowed);
+    expect(perf.status).toBe(202);
+    expect(perf.headers.get("access-control-allow-origin")).toBe(allowed);
+    expect(perf.headers.get("vary")).toContain("Origin");
+
+    const beacon = await post(url, "/client-error", clientError, allowed);
+    expect(beacon.status).toBe(202);
+    expect(beacon.headers.get("access-control-allow-origin")).toBe(allowed);
+  });
+
+  it("accepts a same-origin request (Origin host equals Host)", async () => {
+    const { server, url } = await startServer();
+    servers.push(server);
+    const host = new URL(url).host;
+
+    const beacon = await post(url, "/client-error", clientError, `http://${host}`);
+    expect(beacon.status).toBe(202);
+  });
+
+  it("accepts a non-browser caller with no Origin header", async () => {
+    const { server, url } = await startServer();
+    servers.push(server);
+
+    const perf = await post(url, "/perf", perfSample);
+    expect(perf.status).toBe(202);
+    expect(perf.headers.get("access-control-allow-origin")).toBeNull();
+  });
+});
