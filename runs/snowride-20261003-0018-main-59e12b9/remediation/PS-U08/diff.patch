diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 0000000..39966b1
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,21 @@
+# Repository text/binary policy (finding HYG-P3-002).
+#
+# Normalize text to LF in the repository so a Windows checkout and a Linux CI
+# checkout produce byte-identical files, and so review diffs do not carry
+# line-ending churn.
+* text=auto eol=lf
+
+# Binary assets: never normalize and never attempt a textual diff.
+*.png  binary
+*.jpg  binary
+*.jpeg binary
+*.gif  binary
+*.ico  binary
+*.pdf  binary
+*.zip  binary
+*.dump binary
+
+# Generated snapshots under evidence/ are inputs, not hand-edited review
+# targets: mark them generated to collapse them in review/diff tooling.
+evidence/**          linguist-generated=true
+repomix-output*.xml  linguist-generated=true
