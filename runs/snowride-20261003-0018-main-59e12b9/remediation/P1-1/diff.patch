@@ -0,0 +1,86 @@
+/**
+ * SEC-P1-001: the launch-gate owner approval is an out-of-band detached
+ * signature over the canonical release-identity document, verified at config
+ * load. A committed sentence (or a signature for a different identity) must not
+ * satisfy the gate.
+ */
+import { generateKeyPairSync, sign } from "node:crypto";
+import { describe, expect, it } from "vitest";
+import { canonicalLaunchAttestation, loadConfig } from "../config.js";
+
+const IDENTITY = {
+  rcVersion: "rc-2026-09-23",
+  attestedCommit: "59e12b9b2259ab21ae56113b214160dd1150c5ba",
+  attestedImages: `sha256:${"a".repeat(64)}`,
+  migrationHead: "0056_hash_legacy_gpu.sql",
+  backupId: "snowride-20260923T033748Z.dump",
+  owner: "MaineCyberTech",
+  attestedAt: "2026-09-23T06:45:00Z",
+  attestationExpires: "2026-12-31T00:00:00Z",
+};
+
+const ENV_IDENTITY = {
+  LAUNCH_RC_VERSION: IDENTITY.rcVersion,
+  LAUNCH_ATTESTED_COMMIT: IDENTITY.attestedCommit,
+  LAUNCH_ATTESTED_IMAGES: IDENTITY.attestedImages,
+  LAUNCH_MIGRATION_HEAD: IDENTITY.migrationHead,
+  LAUNCH_BACKUP_ID: IDENTITY.backupId,
+  LAUNCH_OWNER: IDENTITY.owner,
+  LAUNCH_ATTESTED_AT: IDENTITY.attestedAt,
+  LAUNCH_ATTESTATION_EXPIRES: IDENTITY.attestationExpires,
+};
+
+const { publicKey, privateKey } = generateKeyPairSync("ed25519");
+const PUBLIC_PEM = publicKey.export({ type: "spki", format: "pem" }).toString();
+
+function signIdentity(identity: typeof IDENTITY): string {
+  return sign(
+    null,
+    Buffer.from(canonicalLaunchAttestation(identity), "utf8"),
+    privateKey,
+  ).toString("base64");
+}
+
+describe("SEC-P1-001 launch-gate owner attestation", () => {
+  it("accepts a detached signature over the exact identity document", () => {
+    const cfg = loadConfig({
+      ...ENV_IDENTITY,
+      LAUNCH_OWNER_PUBLIC_KEY: PUBLIC_PEM,
+      LAUNCH_OWNER_SIGNATURE: signIdentity(IDENTITY),
+    });
+    expect(cfg.launchGate?.ownerSignature).not.toBe("");
+  });
+
+  it("fails closed when the signed identity is tampered (stale/mismatched)", () => {
+    const signature = signIdentity(IDENTITY);
+    const cfg = loadConfig({
+      ...ENV_IDENTITY,
+      LAUNCH_ATTESTED_COMMIT: "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef",
+      LAUNCH_OWNER_PUBLIC_KEY: PUBLIC_PEM,
+      LAUNCH_OWNER_SIGNATURE: signature,
+    });
+    expect(cfg.launchGate?.ownerSignature).toBe("");
+  });
+
+  it("rejects a free-text approval sentence even with a public key", () => {
+    const cfg = loadConfig({
+      ...ENV_IDENTITY,
+      LAUNCH_OWNER_PUBLIC_KEY: PUBLIC_PEM,
+      LAUNCH_OWNER_SIGNATURE:
+        "MaineCyberTech owner — RC rc-2026-09-23 approved for release",
+    });
+    expect(cfg.launchGate?.ownerSignature).toBe("");
+  });
+
+  it("fails closed when the public key is missing", () => {
+    const cfg = loadConfig({
+      ...ENV_IDENTITY,
+      LAUNCH_OWNER_SIGNATURE: signIdentity(IDENTITY),
+    });
+    expect(cfg.launchGate?.ownerSignature).toBe("");
+  });
+
+  it("stays closed by default (no committed approval)", () => {
+    expect(loadConfig({}).launchGate?.ownerSignature).toBe("");
+  });
+});
