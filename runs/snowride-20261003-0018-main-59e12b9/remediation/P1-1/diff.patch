+      // SEC-P1-001: only a signature that verifies over this exact identity
+      // document (against the out-of-band public key) reaches the gate.
+      ownerSignature: verifyOwnerAttestation(
+        e.LAUNCH_OWNER_PUBLIC_KEY,
+        e.LAUNCH_OWNER_SIGNATURE,
+        canonicalLaunchAttestation({
+          rcVersion: e.LAUNCH_RC_VERSION,
+          attestedCommit: e.LAUNCH_ATTESTED_COMMIT,
+          attestedImages: e.LAUNCH_ATTESTED_IMAGES,
+          migrationHead: e.LAUNCH_MIGRATION_HEAD,
+          backupId: e.LAUNCH_BACKUP_ID,
+          owner: e.LAUNCH_OWNER,
