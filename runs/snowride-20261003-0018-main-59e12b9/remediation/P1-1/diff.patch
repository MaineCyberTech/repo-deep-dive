+/**
+ * SEC-P1-001: canonical release-identity document that an owner detached
+ * signature must cover. The exact UTF-8 bytes (LF separated, fixed order) are
+ * the signed payload — do not reorder or reformat:
+ *
+ *   snowride-launch-attestation-v1
+ *   rc=<rcVersion>
+ *   commit=<attestedCommit>
+ *   images=<attestedImages>
+ *   migration=<migrationHead>
+ *   backup=<backupId>
+ *   owner=<owner>
+ *   attested_at=<attestedAt>
+ *   expires=<attestationExpires>
+ */
+export function canonicalLaunchAttestation(identity: {
+  rcVersion: string;
+  attestedCommit: string;
+  attestedImages: string;
+  migrationHead: string;
+  backupId: string;
+  owner: string;
+  attestedAt: string;
+  attestationExpires: string;
+}): string {
+  return [
+    "snowride-launch-attestation-v1",
+    `rc=${identity.rcVersion}`,
+    `commit=${identity.attestedCommit}`,
+    `images=${identity.attestedImages}`,
+    `migration=${identity.migrationHead}`,
+    `backup=${identity.backupId}`,
+    `owner=${identity.owner}`,
+    `attested_at=${identity.attestedAt}`,
+    `expires=${identity.attestationExpires}`,
+  ].join("\n");
+}
+
+/**
+ * SEC-P1-001: verify the out-of-band owner detached signature over the canonical
+ * identity document. Returns the signature only when it verifies against the
+ * out-of-band PEM public key; otherwise returns "" so the gate fails closed.
+ * A free-text approval sentence (or a signature over any other identity) can no
+ * longer satisfy the gate.
+ */
+export function verifyOwnerAttestation(
+  publicKeyPem: string,
+  signatureBase64: string,
+  canonical: string,
+): string {
+  if (!publicKeyPem.trim() || !signatureBase64.trim()) return "";
+  try {
+    const key = createPublicKey(publicKeyPem);
+    const type = key.asymmetricKeyType;
+    // Ed25519/Ed448 verify with a null digest; RSA/EC use SHA-256.
+    const algorithm = type === "ed25519" || type === "ed448" ? null : "sha256";
+    const ok = cryptoVerify(
+      algorithm,
+      Buffer.from(canonical, "utf8"),
+      key,
+      Buffer.from(signatureBase64, "base64"),
+    );
+    return ok ? signatureBase64 : "";
+  } catch {
+    return "";
+  }
+}
+
 export type RealtimeConfig = {
   port: number;
   bindHost: string;
@@ -341,7 +421,22 @@ export function loadConfig(
