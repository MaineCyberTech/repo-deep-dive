+ */
+export function assertProductionSecrets(
+  env: Pick<Env, "NODE_ENV" | "FIELD_ENCRYPTION_KEY">,
+): void {
+  if (env.NODE_ENV === "production" && !isValidFieldEncryptionKey(env.FIELD_ENCRYPTION_KEY)) {
