diff --git a/automation/vpn/issue-enroll-token.sh b/automation/vpn/issue-enroll-token.sh
index 0c55786..7a6bcc4 100755
--- a/automation/vpn/issue-enroll-token.sh
+++ b/automation/vpn/issue-enroll-token.sh
@@ -3,11 +3,16 @@
 #
 # Usage: issue-enroll-token.sh <device-name>
 #
-# Appends "<device-name>:<token>" to /srv/falcon/secrets/vpn_enroll.token (0600 root) and
-# writes the token to /srv/falcon/secrets/wireguard/clients/<name>.enroll-token (0600) for
-# delivery over the encrypted endpoint channel. A per-device binding overrides the shared
-# token for that name (the service refuses the shared token once a binding exists).
+# Appends "<device-name>:<token>:<expiry-epoch>" to /srv/falcon/secrets/vpn_enroll.token
+# (0600 root) and writes the token to /srv/falcon/secrets/wireguard/clients/<name>.enroll-token
+# (0600) for delivery over the encrypted endpoint channel. A per-device binding overrides the
+# shared token for that name (the service refuses the shared token once a binding exists).
 # Re-running replaces the binding and rotates that device's token.
+#
+# Expiry (API-P2-001): the binding carries a Unix expiry timestamp; the enrollment service
+# rejects an expired token with 403. The lifetime defaults to 86400s (24h) and is configurable
+# with FALCON_ENROLL_TOKEN_TTL_SECONDS. The endpoint enrolls immediately after issuance, so the
+# window only needs to cover delivery; re-run this script to rotate a device that re-enrolls.
 set -euo pipefail
 REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
 source "$REPO_ROOT/bootstrap/lib.sh"
@@ -18,6 +23,11 @@ case "$NAME" in
   ""|*[!a-z0-9-]*) log "invalid name '$NAME': use lowercase letters, digits and dashes"; exit 2 ;;
 esac
 
+TTL="${FALCON_ENROLL_TOKEN_TTL_SECONDS:-86400}"
+case "$TTL" in
+  ""|*[!0-9]*) log "invalid FALCON_ENROLL_TOKEN_TTL_SECONDS '$TTL' (want whole seconds)"; exit 2 ;;
+esac
+
 SEC="/srv/falcon/secrets"
 TOKENS="$SEC/vpn_enroll.token"
 OUTDIR="$SEC/wireguard/clients"
@@ -29,11 +39,13 @@ tmp="$(mktemp "$SEC/.vpn_enroll.token.XXXXXX")"
 chmod 0600 "$tmp"
 grep -v "^${NAME}:" "$TOKENS" > "$tmp" || true
 token="$(openssl rand -hex 24)"
-printf '%s:%s\n' "$NAME" "$token" >> "$tmp"
+now="$(date +%s)"
+expiry="$((now + TTL))"
+printf '%s:%s:%s\n' "$NAME" "$token" "$expiry" >> "$tmp"
 # in-place write keeps the inode and mode the running service already reads
 cat "$tmp" > "$TOKENS"
 rm -f "$tmp"
 printf '%s\n' "$token" > "$OUTDIR/$NAME.enroll-token"
 chmod 0600 "$OUTDIR/$NAME.enroll-token"
-log "per-device token issued for $NAME -> $OUTDIR/$NAME.enroll-token (0600, deliver securely)"
+log "per-device token issued for $NAME (expires $expiry, ttl ${TTL}s) -> $OUTDIR/$NAME.enroll-token (0600, deliver securely)"
 log "the service reads the token file per request; restart only when its code changed"
