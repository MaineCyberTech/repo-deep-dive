@@ -113,6 +119,13 @@ check "re-enroll keeps the address" "10.99.0.21/32" "$(jq -r .address "$WORK/res
 check "one peer block for desktop-02" 1 "$(grep -c '# client peer: desktop-02' "$WORK/wg0.conf")"
 check "rotated key persisted" 1 "$(grep -c "$PUB3" "$WORK/wg0.conf")"
 
+# Token expiry (API-P2-001): an expired or malformed-expiry binding is refused; a future
