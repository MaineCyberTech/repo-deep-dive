@@ -0,0 +1,117 @@
+#!/usr/bin/env bash
+# Offline regression test for automation/validation/check_event_time_consistency.py
+# (DATA-P2-001). No network, docker, cluster or secrets; fixtures only.
+# Asserts: the template pin and the Vector emitter agree -> pass; a template type drift,
+# a transform that emits a non-timestamp, and a missing emitter each fail closed; and the
+# check is wired into ci/validate.py.
+set -u
+ROOT="$(cd "$(dirname "$(dirname "$(dirname "$(dirname "$0")")")")" && pwd)"
+SCRIPT="$ROOT/automation/validation/check_event_time_consistency.py"
+VALIDATE="$ROOT/ci/validate.py"
+mkdir -p /tmp/opencode
+WORK="$(mktemp -d /tmp/opencode/event-time-consistency-test-XXXXXX)"
+trap 'rm -rf "$WORK"' EXIT
+
+# Build a minimal fixture repository: template + one Vector remap transform.
+python3 - "$WORK" <<'PY'
+import json, os, sys
+work = sys.argv[1]
+os.makedirs(os.path.join(work, "config", "opensearch"))
+os.makedirs(os.path.join(work, "config", "vector"))
+template = {"template": {"mappings": {"dynamic": False, "properties": {
+    "timestamp": {"type": "date"},
+    "event_time": {"type": "date"},
+}}}}
+with open(os.path.join(work, "config", "opensearch", "falcon-eve-template.json"), "w") as fh:
+    json.dump(template, fh)
+vector = """transforms:
+  syslog_identity:
+    type: remap
+    inputs: [syslog_tcp]
+    source: |
+      event_time = null
+      parsed, err = parse_timestamp(.timestamp, format: "%Y-%m-%d %H:%M:%S", timezone: "America/New_York")
+      if err == null { event_time = parsed }
+      .event_time = event_time
+      .timestamp = now()
+sinks:
+  opensearch:
+    type: elasticsearch
+"""
+with open(os.path.join(work, "config", "vector", "aggregator.yaml"), "w") as fh:
+    fh.write(vector)
+PY
+
+run() { python3 "$SCRIPT" --root "$1" 2>&1; }
+
+CHECKS=0 FAILS=0
+check() {  # check <desc> <expected> <actual>
+  CHECKS=$((CHECKS + 1))
+  if [ "$2" != "$3" ]; then echo "FAIL: $1 (expected '$2', got '$3')"; FAILS=$((FAILS + 1)); fi
+}
+contains() {  # contains <desc> <needle> <haystack>
+  CHECKS=$((CHECKS + 1))
+  case "$3" in *"$2"*) : ;; *) echo "FAIL: $1 (missing '$2')"; FAILS=$((FAILS + 1)) ;; esac
+}
+
+echo "== case 1: template date + timestamp emitter passes =="
+out="$(run "$WORK")"; rc=$?
+check "exit 0" "0" "$rc"
+contains "pass line" "PASS event_time consistency" "$out"
+contains "emitter named" "aggregator.yaml:syslog_identity" "$out"
+
+echo "== case 2: template type drift fails =="
+python3 - "$WORK" <<'PY'
+import json, os, sys
+path = os.path.join(sys.argv[1], "config", "opensearch", "falcon-eve-template.json")
+t = json.load(open(path))
+t["template"]["mappings"]["properties"]["event_time"] = {"type": "keyword"}
+json.dump(t, open(path, "w"))
+PY
+out="$(run "$WORK")"; rc=$?
+check "exit 1" "1" "$rc"
+contains "template failure" "expected 'date'" "$out"
+# restore
+python3 - "$WORK" <<'PY'
+import json, os, sys
+path = os.path.join(sys.argv[1], "config", "opensearch", "falcon-eve-template.json")
+t = json.load(open(path))
+t["template"]["mappings"]["properties"]["event_time"] = {"type": "date"}
+json.dump(t, open(path, "w"))
+PY
+
+echo "== case 3: transform emits a string (parse_timestamp used elsewhere) fails =="
+python3 - "$WORK" <<'PY'
+import os, sys
+path = os.path.join(sys.argv[1], "config", "vector", "aggregator.yaml")
+src = open(path).read().replace('.event_time = event_time', '.event_time = "2026-10-01T00:00:00Z"')
+open(path, "w").write(src)
+PY
+out="$(run "$WORK")"; rc=$?
+check "exit 1" "1" "$rc"
+contains "string failure" "not a timestamp" "$out"
+python3 - "$WORK" <<'PY'
+import os, sys
+path = os.path.join(sys.argv[1], "config", "vector", "aggregator.yaml")
+src = open(path).read().replace('.event_time = "2026-10-01T00:00:00Z"', '.event_time = event_time')
+open(path, "w").write(src)
+PY
+
+echo "== case 4: no emitter fails (field orphaned) =="
+python3 - "$WORK" <<'PY'
+import os, sys
+path = os.path.join(sys.argv[1], "config", "vector", "aggregator.yaml")
+src = open(path).read().replace('.event_time = event_time', '.event_time_other = event_time')
+open(path, "w").write(src)
+PY
+out="$(run "$WORK")"; rc=$?
+check "exit 1" "1" "$rc"
+contains "orphan failure" "no remap transform emits" "$out"
+
+echo "== case 5: check is wired into ci/validate.py =="
+out="$(python3 "$VALIDATE" --only event-time-consistency 2>&1)"; rc=$?
+check "gate exit 0" "0" "$rc"
+contains "gate pass" "PASS  event_time template/Vector consistency" "$out"
+
+echo "event_time_consistency_test_checks=$CHECKS event_time_consistency_test_failures=$FAILS"
+exit "$FAILS"
