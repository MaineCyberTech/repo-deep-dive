+#!/usr/bin/env python3
+"""Offline consistency check for the `event_time` field (audit DATA-P2-001).
+
+The `event_time` contract is owned by two files that are edited independently:
+
+  * `config/opensearch/falcon-eve-template.json` - the index template that pins the
+    field type; it is the deployed source of truth (`bootstrap/61-search-policies.sh`).
+  * `config/vector/{aggregator,edge}.yaml` - the remap transforms that emit
+    `event_time` (device wall clock re-interpreted in the device IANA timezone).
+
+`mapping_drift_check.py` compares the *live* indices against the template, but it
+needs docker, credentials and a running cluster, so nothing asserts at HEAD that the
+two owners still agree. A drift there fails silently: the template maps `event_time`
+as `date`, so a transform that emits a string re-maps the field on the next daily
+index and the `.keyword`/range consumers return empty (mapping-drift class, R-25).
+
+This check is static and offline:
+
+  1. The template must pin `event_time` as `date`.
+  2. Every Vector remap transform that assigns `.event_time` must derive the value
+     from a timestamp producer (`parse_timestamp(...)` / `now()`), directly or
+     through a local variable, so the emitted value is an OpenSearch `date`. A
+     transform that assigns a string/number literal is a failure (an explicit
+     `null` means the field is unset for that event).
+  3. At least one transform must emit `event_time` (otherwise the field is orphaned).
+
+Usage: check_event_time_consistency.py [--root DIR]
+Exit:  0 = template and Vector transforms agree
+       1 = drift / missing owner
+       2 = usage or parse error
+"""
+import argparse
+import os
+import re
+import sys
+
+import yaml
+
+DEFAULT_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+TEMPLATE_REL = os.path.join("config", "opensearch", "falcon-eve-template.json")
+VECTOR_GLOB = os.path.join("config", "vector")
+
+# A field assignment to the emitted document; the local form omits the leading dot.
+FIELD_ASSIGN_RE = re.compile(r"^\s*\.event_time\s*=\s*(.+?)\s*$")
+# `name, err = parse_timestamp(...)` and `name = parse_timestamp(...)`.
+TUPLE_ASSIGN_RE = re.compile(
+    r"^\s*([A-Za-z_]\w*)\s*,\s*[A-Za-z_]\w*\s*(?<![=!<>])=(?!=)\s*(.+?)\s*$")
+LOCAL_ASSIGN_RE = re.compile(
+    r"^\s*([A-Za-z_]\w*)\s*(?<![=!<>])=(?!=)\s*(.+?)\s*$")
+TIMESTAMP_PRODUCER = re.compile(r"\b(?:parse_timestamp|from_unix_timestamp|now)\s*\(")
+IDENT_RE = re.compile(r"^[A-Za-z_]\w*$")
+NULL_LITERAL = "null"
+
+
+def template_event_time_type(root):
+    """The template's `event_time` type, or None when the field is not pinned."""
+    import json
+
+    path = os.path.join(root, TEMPLATE_REL)
+    with open(path, encoding="utf-8") as fh:
+        template = json.load(fh)
+    node = template.get("template", {}).get("mappings", {}).get("properties", {}).get("event_time")
+    if not isinstance(node, dict):
+        return None
+    return node.get("type")
+
+
+def _statements(source):
+    """VRL statements: split on newlines, braces and semicolons so inline blocks
+    (`if err == null { event_time = parsed }`) are parsed as separate statements."""
+    return [s for s in re.split(r"[\n{};]+", source) if s.strip()]
+
+
+def timestamp_vars(source):
+    """Local variables that resolve to a Vector timestamp (transitively)."""
+    tuples = []
+    simples = []
+    for stmt in _statements(source):
+        m = TUPLE_ASSIGN_RE.match(stmt)
+        if m:
+            tuples.append((m.group(1), m.group(2)))
+            continue
+        m = LOCAL_ASSIGN_RE.match(stmt)
+        if m:
+            simples.append((m.group(1), m.group(2)))
+
+    resolved = set()
+    for _ in range(len(tuples) + len(simples) + 1):
+        changed = False
+        for name, expr in tuples + simples:
+            if name in resolved:
+                continue
+            if TIMESTAMP_PRODUCER.search(expr):
+                resolved.add(name)
+                changed = True
+            elif IDENT_RE.match(expr.strip()) and expr.strip() in resolved:
+                resolved.add(name)
+                changed = True
+        if not changed:
+            break
+    return resolved
+
+
+def event_time_assignments(source):
+    """RHS expressions of every `.event_time = ...` field assignment."""
+    assignments = []
+    for stmt in _statements(source):
+        m = FIELD_ASSIGN_RE.match(stmt)
+        if m:
+            assignments.append(m.group(1))
+    return assignments
+
+
+def transform_issues(name, source):
+    """Failures for one remap transform's event_time handling (empty when clean)."""
+    assignments = event_time_assignments(source)
+    if not assignments:
+        return []  # this transform does not emit event_time
+
+    ts_vars = timestamp_vars(source)
+    issues = []
+    for expr in assignments:
+        expr = expr.strip()
+        if TIMESTAMP_PRODUCER.search(expr):
+            continue
+        if IDENT_RE.match(expr):
+            if expr in ts_vars:
+                continue
+            issues.append(f"transform {name!r}: .event_time = {expr} is not a timestamp variable")
+        elif expr == NULL_LITERAL:
+            continue  # explicitly unset; the field is simply absent for that event
+        else:
+            issues.append(f"transform {name!r}: .event_time = {expr} is not a timestamp expression")
+    return issues
+
+
+def vector_emitters(root):
+    """[(file, transform, issues)] for every Vector transform in config/vector/."""
+    vector_dir = os.path.join(root, VECTOR_GLOB)
+    results = []
+    if not os.path.isdir(vector_dir):
+        return results
+    for fn in sorted(os.listdir(vector_dir)):
+        if not fn.endswith((".yaml", ".yml")):
+            continue
+        path = os.path.join(vector_dir, fn)
+        with open(path, encoding="utf-8") as fh:
+            config = yaml.safe_load(fh) or {}
+        for name, transform in (config.get("transforms") or {}).items():
+            if not isinstance(transform, dict) or transform.get("type") != "remap":
+                continue
+            source = transform.get("source") or ""
+            if event_time_assignments(source):
+                results.append((fn, name, transform_issues(name, source)))
+    return results
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--root", default=DEFAULT_ROOT)
+    args = ap.parse_args(argv)
+    root = os.path.abspath(args.root)
+
+    try:
+        event_time_type = template_event_time_type(root)
+        emitters = vector_emitters(root)
+    except (OSError, yaml.YAMLError) as exc:
+        print(f"event_time_consistency: ERROR {exc}", file=sys.stderr)
+        return 2
+
+    fails = []
+    if event_time_type != "date":
+        fails.append(
+            f"{TEMPLATE_REL}: event_time type is {event_time_type!r}, expected 'date' "
+            "(mapping drift can silently drop the field from consumer queries)")
+
+    if not emitters:
+        fails.append(
+            f"{VECTOR_GLOB}: no remap transform emits .event_time (field orphaned)")
+
+    for fn, name, issues in emitters:
+        for issue in issues:
+            fails.append(f"{os.path.join(VECTOR_GLOB, fn)}: {issue}")
+
+    if fails:
+        print("FAIL event_time consistency (DATA-P2-001)")
+        for f in fails:
+            print("  " + f)
+        return 1
+
+    emitters_desc = ", ".join(f"{fn}:{name}" for fn, name, _ in emitters)
+    print(f"PASS event_time consistency: template pins date; {len(emitters)} emitter(s) "
+          f"produce timestamps ({emitters_desc})")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
