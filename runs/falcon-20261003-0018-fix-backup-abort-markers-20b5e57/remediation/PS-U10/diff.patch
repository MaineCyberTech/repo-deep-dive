diff --git a/bootstrap/90-alerting.sh b/bootstrap/90-alerting.sh
index af9c011..83c144f 100755
--- a/bootstrap/90-alerting.sh
+++ b/bootstrap/90-alerting.sh
@@ -528,6 +528,15 @@ write_rule "falcon-relay-publish-failures" \
   "Alert relay publish failures" 'increase(falcon_alert_relay_publish_failures_total[15m]) > 0' "5m" "critical" \
   "The alert relay failed to publish one or more notifications (check the independent ntfy path)."
 
+# OBS-P1-003 (per-path delivery): publish_failures_total only moves when EVERY delivery
+# path fails, so one degraded destination (lab or independent) stays invisible until the
+# weekly canary. The relay already exports per-path outcomes
+# (falcon_alert_relay_path_failures_total{path="lab|alt"}, automation/alerting/ntfy_relay.py);
+# alert on any path failing so partial-path loss is caught within one evaluation interval.
+write_rule "falcon-relay-path-failures" \
+  "Alert relay delivery path failing" 'increase(falcon_alert_relay_path_failures_total[15m]) > 0' "5m" "warning" \
+  "The alert relay failed to deliver to one delivery path (lab or independent) in the last 15 minutes while the other path kept working; a degraded destination may be silently dropping alerts."
+
