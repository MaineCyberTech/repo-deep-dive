   "New-services backup stale" '(time() - falcon_backup_newservices_last_success_timestamp_seconds) > 129600' "10m" "warning" \
   "No successful new-services archive within 36 hours (WireGuard keys / Wazuh registry / IRIS / enrollment may be unprotected)."
