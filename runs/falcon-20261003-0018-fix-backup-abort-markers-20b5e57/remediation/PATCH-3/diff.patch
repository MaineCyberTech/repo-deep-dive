+# FEAT-P2-002: the offsite retry/backoff path (80-offsite-backup.sh, RES-P0-002) leaves a
+# persistent dead-letter marker when every attempt is exhausted and removes it on the next
+# fully successful run. Surface it so exhausted retries are alertable immediately instead
+# of only after the 36 h freshness rule; a successful run clears both the marker and this.
+offsite_dlq=0
+offsite_dlq_age=-1
+if [ -s "$STATE_OFFSITE_DLQ" ]; then
+  offsite_dlq=1
+  offsite_dlq_mtime="$(date -u -r "$STATE_OFFSITE_DLQ" +%s 2>/dev/null || echo 0)"
+  if [ "${offsite_dlq_mtime:-0}" -gt 0 ]; then
+    offsite_dlq_age=$(( $(date +%s) - offsite_dlq_mtime ))
+  fi
+fi
