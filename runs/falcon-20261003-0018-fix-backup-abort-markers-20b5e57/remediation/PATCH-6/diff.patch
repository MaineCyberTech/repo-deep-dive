@@ -0,0 +1,208 @@
+#!/usr/bin/env python3
+"""CI equality test binding the delivered artifacts (FINAL-P0-001, HYG-P0-001/002).
+
+Fails closed unless:
+
+  1. PACKAGE_DIGEST.txt names one and the same commit in repository_commit,
+     CLOSEOUT_SOURCE_COMMIT and DELIVERED_PACKAGE_COMMIT;
+  2. closeout/FINAL_RESPONSE.json (and the superseding record, when present) names the
+     SAME commit in ``commit`` and publication_chain;
+  3. the digest and the closeout agree on the review-package and evidence manifest hashes,
+     and those hashes/entry count match the shipped files;
+  4. (with a git checkout) the declared commit resolves, is HEAD or an ancestor of HEAD, and
+     every commit between the declared commit and HEAD touches only publication artifacts or
+     this test; and the declared-commit tree's manifests match the digest (the authoritative
+     binding check).
+
+A file cannot name its own commit, so the repository's documented PUBLICATION_RELATIONSHIP
+allows a publication commit (which adds only publication artifacts) after the declared
+commit; that allowance is encoded explicitly and nothing else is tolerated.
+
+Usage: check_publication_equality.py [--root DIR] [--no-git]
+Exit:  0 = bound and equal, 1 = mismatch, 2 = usage error.
+"""
+import argparse
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+
+# Files a commit may touch after the declared/frozen commit without invalidating the digest.
+# This is the PUBLICATION_RELATIONSHIP artifact set plus this test's own files.
+PUB_ARTIFACTS = re.compile(
+    r"^(PACKAGE_DIGEST\.txt|PACKAGE_MANIFEST\.sha256|PACK_VERIFICATION_NOTES\.txt|"
+    r"PACK_NOT_INCLUDED\.txt|closeout/FINAL_RESPONSE.*\.json|"
+    r"ci/validate\.py|automation/validation/check_publication_equality\.py|"
+    r"automation/validation/tests/.*)$"
+)
+
+
+def sha256_file(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(65536), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def parse_digest(path):
+    out = {}
+    with open(path, encoding="utf-8") as fh:
+        for line in fh:
+            line = line.strip()
+            if not line or line.startswith("#") or "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            out[key.strip()] = value.strip()
+    return out
+
+
+def git(root, *args):
+    return subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)
+
+
+def git_blob_sha256(root, rev, path):
+    proc = subprocess.run(["git", "-C", root, "show", "%s:%s" % (rev, path)],
+                          capture_output=True)
+    if proc.returncode != 0:
+        return None
+    return hashlib.sha256(proc.stdout).hexdigest()
+
+
+def git_blob_lines(root, rev, path):
+    proc = subprocess.run(["git", "-C", root, "show", "%s:%s" % (rev, path)],
+                          capture_output=True, text=True)
+    if proc.returncode != 0:
+        return None
+    return len(proc.stdout.splitlines())
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--root", default=os.path.dirname(os.path.dirname(
+        os.path.dirname(os.path.abspath(__file__)))))
+    ap.add_argument("--no-git", action="store_true",
+                    help="skip git ancestry/declared-commit checks (offline unit test)")
+    args = ap.parse_args()
+    root = os.path.abspath(args.root)
+
+    digest_path = os.path.join(root, "PACKAGE_DIGEST.txt")
+    closeout_path = os.path.join(root, "closeout", "FINAL_RESPONSE.json")
+    if not os.path.exists(digest_path) or not os.path.exists(closeout_path):
+        print("SKIP publication equality (PACKAGE_DIGEST.txt or closeout/FINAL_RESPONSE.json absent)")
+        return 0
+
+    digest = parse_digest(digest_path)
+    closeout = json.load(open(closeout_path, encoding="utf-8"))
+    pc = closeout.get("publication_chain", {}) or {}
+
+    checks, fails = [], []
+
+    def check(label, cond, detail=""):
+        if cond:
+            checks.append("ok   " + label)
+        else:
+            fails.append(label + ((" (" + detail + ")") if detail else ""))
+
+    d_repo = digest.get("repository_commit", "")
+    d_src = digest.get("CLOSEOUT_SOURCE_COMMIT", "")
+    d_del = digest.get("DELIVERED_PACKAGE_COMMIT", "")
+    d_pkg = digest.get("review_package_manifest_sha256", "")
+    d_ev = digest.get("evidence_manifest_sha256", "")
+    d_n = digest.get("review_package_entries", "")
+
+    check("digest repository_commit == CLOSEOUT_SOURCE_COMMIT",
+          d_repo and d_repo == d_src, "repo=%s src=%s" % (d_repo, d_src))
+    check("digest repository_commit == DELIVERED_PACKAGE_COMMIT",
+          d_repo and d_repo == d_del, "repo=%s del=%s" % (d_repo, d_del))
+
+    j_commit = closeout.get("commit", "")
+    check("closeout commit == publication_chain.CLOSEOUT_SOURCE_COMMIT",
+          j_commit and j_commit == pc.get("CLOSEOUT_SOURCE_COMMIT", ""),
+          "commit=%s src=%s" % (j_commit, pc.get("CLOSEOUT_SOURCE_COMMIT", "")))
+    check("closeout commit == publication_chain.DELIVERED_PACKAGE_COMMIT",
+          j_commit and j_commit == pc.get("DELIVERED_PACKAGE_COMMIT", ""),
+          "commit=%s del=%s" % (j_commit, pc.get("DELIVERED_PACKAGE_COMMIT", "")))
+    check("digest repository_commit == closeout commit (cross-artifact)",
+          d_repo and d_repo == j_commit, "digest=%s closeout=%s" % (d_repo, j_commit))
+
+    superseding_path = os.path.join(
+        root, "closeout", "FINAL_RESPONSE_SUPERSEDING_2026-09-23.json")
+    if os.path.exists(superseding_path):
+        sup = json.load(open(superseding_path, encoding="utf-8"))
+        spc = sup.get("publication_chain", {}) or {}
+        check("superseding closeout names the same commit",
+              sup.get("commit") == d_repo
+              and spc.get("CLOSEOUT_SOURCE_COMMIT") == d_repo
+              and spc.get("DELIVERED_PACKAGE_COMMIT") == d_repo)
+
+    rp = os.path.join(root, "review-package", "MANIFEST.sha256")
+    ev = os.path.join(root, "evidence", "MANIFEST.sha256")
+    rp_actual = sha256_file(rp) if os.path.exists(rp) else None
+    ev_actual = sha256_file(ev) if os.path.exists(ev) else None
+    if rp_actual is not None:
+        check("digest review_package_manifest_sha256 matches shipped manifest",
+              d_pkg == rp_actual, "declared=%s actual=%s" % (d_pkg, rp_actual))
+        check("closeout review_package_manifest_sha256 matches shipped manifest",
+              closeout.get("review_package_manifest_sha256") == rp_actual,
+              "declared=%s actual=%s" % (closeout.get("review_package_manifest_sha256"), rp_actual))
+        n_actual = sum(1 for _ in open(rp, encoding="utf-8"))
+        check("digest review_package_entries matches shipped manifest",
+              str(n_actual) == str(d_n), "declared=%s actual=%s" % (d_n, n_actual))
+    if ev_actual is not None:
+        check("digest evidence_manifest_sha256 matches shipped manifest",
+              d_ev == ev_actual, "declared=%s actual=%s" % (d_ev, ev_actual))
+        check("closeout evidence_manifest_sha256 matches shipped manifest",
+              closeout.get("evidence_manifest_sha256") == ev_actual,
+              "declared=%s actual=%s" % (closeout.get("evidence_manifest_sha256"), ev_actual))
+
+    is_git = os.path.isdir(os.path.join(root, ".git"))
+    if not args.no_git and is_git and d_repo:
+        if git(root, "cat-file", "-e", "%s^{commit}" % d_repo).returncode != 0:
+            check("declared commit resolves in this clone", False, d_repo)
+        else:
+            check("declared commit resolves in this clone", True)
+            head = git(root, "rev-parse", "HEAD").stdout.strip()
+            is_anc = head == d_repo or git(
+                root, "merge-base", "--is-ancestor", d_repo, head).returncode == 0
+            check("declared commit is HEAD or an ancestor of HEAD", is_anc,
+                  "declared=%s HEAD=%s" % (d_repo, head))
+            if is_anc and head != d_repo:
+                revs = git(root, "rev-list", "--ancestry-path",
+                           "%s..HEAD" % d_repo).stdout.split()
+                bad = []
+                for c in revs:
+                    names = git(root, "diff-tree", "--no-commit-id", "--name-only",
+                                "-r", c).stdout.split()
+                    for name in names:
+                        if not PUB_ARTIFACTS.match(name):
+                            bad.append("%s:%s" % (c[:8], name))
+                check("commits after the declared commit touch only publication/test files",
+                      not bad, "; ".join(bad[:5]))
+            if rp_actual is not None:
+                gh = git_blob_sha256(root, d_repo, "review-package/MANIFEST.sha256")
+                check("declared-commit review-package manifest hash matches digest",
+                      gh == d_pkg, "declared-commit=%s digest=%s" % (gh, d_pkg))
+                gn = git_blob_lines(root, d_repo, "review-package/MANIFEST.sha256")
+                check("declared-commit review-package entries match digest",
+                      gn is not None and str(gn) == str(d_n), "declared-commit=%s digest=%s" % (gn, d_n))
+            if ev_actual is not None:
+                eh = git_blob_sha256(root, d_repo, "evidence/MANIFEST.sha256")
+                check("declared-commit evidence manifest hash matches digest",
+                      eh == d_ev, "declared-commit=%s digest=%s" % (eh, d_ev))
+
+    for line in checks:
+        print(line)
+    if fails:
+        print("FAIL publication equality")
+        for f in fails:
+            print("  " + f)
+        return 1
+    print("PASS publication equality")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
