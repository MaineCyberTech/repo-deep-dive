index 0000000..50cf99e
--- /dev/null
+++ b/automation/validation/tests/publication_equality_test.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# Regression (FINAL-P0-001 / HYG-P0-001/002): the publication-equality checker must pass a
+# correctly bound digest+closeout and fail on a mismatched commit or manifest hash.
+# Offline by design (--no-git); no network/root/docker.
+set -u
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
+CHECK="$REPO_ROOT/automation/validation/check_publication_equality.py"
+TMP="$(mktemp -d "${TMPDIR:-/tmp}/publication-equality-XXXXXX")"
+trap 'rm -rf "$TMP"' EXIT
+
+mkdir -p "$TMP/review-package" "$TMP/evidence" "$TMP/closeout"
+printf 'entry-one\n' > "$TMP/review-package/MANIFEST.sha256"
+printf 'evidence-one\n' > "$TMP/evidence/MANIFEST.sha256"
+RP="$(sha256sum "$TMP/review-package/MANIFEST.sha256" | awk '{print $1}')"
+EV="$(sha256sum "$TMP/evidence/MANIFEST.sha256" | awk '{print $1}')"
+C="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+
+cat > "$TMP/PACKAGE_DIGEST.txt" <<EOF
+# synthetic
+repository_commit=$C
+CLOSEOUT_SOURCE_COMMIT=$C
+DELIVERED_PACKAGE_COMMIT=$C
+review_package_manifest_sha256=$RP
+review_package_entries=1
+evidence_manifest_sha256=$EV
+EOF
+
+cat > "$TMP/closeout/FINAL_RESPONSE.json" <<EOF
+{
+  "commit": "$C",
+  "publication_chain": {
+    "CLOSEOUT_SOURCE_COMMIT": "$C",
+    "DELIVERED_PACKAGE_COMMIT": "$C"
+  },
+  "review_package_manifest_sha256": "$RP",
+  "evidence_manifest_sha256": "$EV"
+}
+EOF
+
+if ! python3 "$CHECK" --root "$TMP" --no-git >/dev/null; then
+  echo "FAIL: a correctly bound digest+closeout should pass"; exit 1
+fi
+
+# 1. digest names a different commit than the closeout.
+sed -i "s/^repository_commit=.*/repository_commit=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/" "$TMP/PACKAGE_DIGEST.txt"
+if python3 "$CHECK" --root "$TMP" --no-git >/dev/null 2>&1; then
+  echo "FAIL: a digest/closeout commit mismatch should fail"; exit 1
+fi
+sed -i "s/^repository_commit=.*/repository_commit=$C/" "$TMP/PACKAGE_DIGEST.txt"
+
+# 2. digest declares a manifest hash that does not match the shipped manifest.
+sed -i "s/^review_package_manifest_sha256=.*/review_package_manifest_sha256=deadbeef/" "$TMP/PACKAGE_DIGEST.txt"
+if python3 "$CHECK" --root "$TMP" --no-git >/dev/null 2>&1; then
+  echo "FAIL: a mutated manifest hash should fail"; exit 1
+fi
+sed -i "s/^review_package_manifest_sha256=.*/review_package_manifest_sha256=$RP/" "$TMP/PACKAGE_DIGEST.txt"
+
+# 3. closeout names a different commit than the digest.
+sed -i "s/\"commit\": \"$C\"/\"commit\": \"cccccccccccccccccccccccccccccccccccccccc\"/" "$TMP/closeout/FINAL_RESPONSE.json"
+if python3 "$CHECK" --root "$TMP" --no-git >/dev/null 2>&1; then
+  echo "FAIL: a closeout commit mismatch should fail"; exit 1
+fi
+
+echo "PASS publication_equality_test"
