+def check_digest_binding():
+    """HYG-P1-001: PACKAGE_DIGEST.txt must bind the shipped manifests.
+
+    Delegates to automation/validation/check_digest_binding.py (the owner tool, also run
+    as a CI step) so the repository's single local gate and CI share one implementation:
+    the declared review-package/evidence manifest hashes must equal the shipped files and
+    the declared repository_commit must resolve in the clone. A stale package or digest
+    therefore fails here instead of being mistaken for current.
+    """
+    proc = subprocess.run(
+        [sys.executable, os.path.join(REPO, "automation", "validation",
+                                      "check_digest_binding.py"), "--root", REPO],
+        capture_output=True, text=True,
+    )
+    if proc.returncode != 0:
+        fail("digest binding (HYG-P1-001)")
+        print(proc.stdout, end="")
+        print(proc.stderr, end="")
+    else:
+        ok("digest binding (PACKAGE_DIGEST binds the shipped manifests)")
+
+
+def check_sbom_hashes():
+    """HYG-P2-001: the committed SBOM/vulnerability set must match its manifest.
+
+    Delegates to automation/validation/sbom_hashes.sh verify (also run as a CI step):
+    every sbom/*.cdx.json, sbom/vuln/*.json and the summary must match
+    sbom/SBOM_MANIFEST.sha256, and an unlisted artifact fails. Keeps the generated set
+    honest while it remains committed; publishing it as CI/release assets instead is the
+    owner decision recorded for the finding.
+    """
+    script = os.path.join(REPO, "automation", "validation", "sbom_hashes.sh")
+    if not os.path.isfile(script):
+        ok("sbom hashes (skipped: sbom_hashes.sh absent)")
+        return
+    proc = subprocess.run(["bash", script, "verify"], capture_output=True, text=True)
+    if proc.returncode != 0:
+        fail("sbom hashes (HYG-P2-001)")
+        print(proc.stdout, end="")
+        print(proc.stderr, end="")
+    else:
+        ok("sbom hashes (committed SBOM/vuln set matches SBOM_MANIFEST.sha256)")
+
+
