+#!/usr/bin/env bash
+# Regression guards for the exposure-edge fixes (SEC-P1-001/002/003).
+#
+# Cheap static checks over the files the fix touched. Offline by design (no root,
+# docker, network or /srv); runs in ci/validate.py's shell-test suite.
+# Exit 0 = all guards present.
+set -u
+REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
+fail=0
+
+check() {  # <relative-path> <extended-regex> <description>
+  local file="$1" pat="$2" desc="$3"
+  if [ ! -f "$REPO_ROOT/$file" ]; then
+    echo "FAIL: $file missing"; fail=1; return
+  fi
+  if ! grep -qE "$pat" "$REPO_ROOT/$file"; then
+    echo "FAIL: $file: $desc"; fail=1
+  fi
+}
+
+check_absent() {  # <relative-path> <extended-regex> <description>
+  local file="$1" pat="$2" desc="$3"
+  if [ ! -f "$REPO_ROOT/$file" ]; then
+    echo "FAIL: $file missing"; fail=1; return
+  fi
+  if grep -qE "$pat" "$REPO_ROOT/$file"; then
+    echo "FAIL: $file still matches: $desc"; fail=1
+  fi
+}
+
+NFT=config/nftables/falcon.nft
+OC=compose/mct/docker-compose.opencanary.yml
+INB=bootstrap/32-inbound-mode.sh
+DOC=docs/architecture/PORT_PROTOCOL_MATRIX.md
+
+# SEC-P1-002: the blanket wg0 accept is gone; explicit per-port tunnel allows replace it.
+check_absent "$NFT" 'iifname "wg0" accept[[:space:]]+comment' "blanket wg0 accept"
+check "$NFT" 'iifname "wg0" tcp dport 9443 accept' "wg0 9443 allow"
+check "$NFT" 'iifname "wg0" tcp dport \{ 15140, 15141 \} accept' "wg0 Wazuh proxy allow"
+check "$NFT" 'iifname "wg0" udp dport \{ 514, 2055 \} accept' "wg0 syslog/NetFlow allow"
+
+# SEC-P1-001: decoy ports must carry an explicit host bind, not a bare all-interface map.
+check_absent "$OC" '^[[:space:]]*- "21:21"' "bare opencanary port bind"
+check "$OC" '\$\{OPENCANARY_BIND_ADDR:-[0-9.]+\}:21:21' "opencanary 21 bind address"
+check "$OC" '\$\{OPENCANARY_BIND_ADDR:-[0-9.]+\}:9100:9100' "opencanary 9100 bind address"
+
+# SEC-P1-003: the runtime state file is authoritative and every toggle is recorded.
+check "$INB" 'inbound-mode-ledger\.md' "runtime inbound ledger"
+check "$INB" 'record_toggle' "toggle recorder"
+check "$INB" 'DRIFT: recorded' "status drift check"
+check "$DOC" 'authoritative' "matrix authority note"
+
+if [ "$fail" -eq 0 ]; then
+  echo "PASS exposure_edges"
+else
+  exit 1
+fi
