@@ -11,7 +11,20 @@ source "$(dirname "$0")/lib.sh"
 require_root
 
 MODE="${1:-status}"
-STATE="/srv/falcon/compose-state/inbound-mode"
+STATE_DIR="/srv/falcon/compose-state"
+# The runtime state file is authoritative (SEC-P1-003). Every toggle is appended to the
+# runtime ledger below so the host's actual exposure is auditable without reading ledgers
+# that can drift; `status` reconciles the file against the live nft policy and fails closed
+# on unknown or mismatched state.
+STATE="$STATE_DIR/inbound-mode"
+LEDGER="$STATE_DIR/inbound-mode-ledger.md"
+
+record_toggle() {  # <mode> [source]
+  mkdir -p "$STATE_DIR"
+  printf '%s\n' "$1" > "$STATE"
+  [ -f "$LEDGER" ] || printf '# Inbound-mode ledger (append-only)\n\n| When (UTC) | Mode | Source |\n|---|---|---|\n' >> "$LEDGER"
+  printf '| %s | %s | %s |\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "${2:-32-inbound-mode.sh}" >> "$LEDGER"
+}
 
 case "$MODE" in
   open)
@@ -21,7 +34,7 @@ case "$MODE" in
     nft -f /etc/nftables.conf
     iptables -F DOCKER-USER
     iptables -A DOCKER-USER -m comment --comment "falcon-lab: temporary open inbound" -j RETURN
-    echo open > "$STATE"
+    record_toggle open
     log "inbound mode is now: open (all sources accepted; SSH new connections rate-limited)"
     ;;
   closed)
@@ -29,7 +42,7 @@ case "$MODE" in
     # Record the mode before applying the DOCKER-USER rules: 31-docker-user-firewall.sh
     # reads the state file to decide between the allowlist and allow-all, so writing it
     # afterwards left the forwarded path open (finding C-30).
-    echo closed > "$STATE"
+    record_toggle closed
     install -m 0644 "$REPO_ROOT/config/nftables/falcon.nft" /etc/nftables.conf
     nft -c -f /etc/nftables.conf
     nft -f /etc/nftables.conf
@@ -37,10 +50,22 @@ case "$MODE" in
     log "inbound mode is now: closed (default-deny with allowlists)"
     ;;
   status)
-    if [ -f "$STATE" ]; then
-      log "recorded mode: $(cat "$STATE")"
-    else
-      log "no state file; recorded mode: unknown"
+    recorded="unknown"
+    [ -f "$STATE" ] && recorded="$(cat "$STATE" 2>/dev/null || echo unknown)"
+    live="unknown"
+    pol="$(nft list chain inet falcon_filter input 2>/dev/null \
+      | sed -n 's/.*policy \([a-z]*\).*/\1/p' | head -1)"
+    case "$pol" in accept) live="open" ;; drop) live="closed" ;; esac
+    log "recorded mode: $recorded (authoritative state file: $STATE)"
+    log "live input policy: ${pol:-unknown} -> mode ${live}"
+    [ -f "$LEDGER" ] && { log "recent toggles:"; tail -n 5 "$LEDGER"; }
+    if [ "$recorded" = "unknown" ]; then
+      log "no recorded state; cannot confirm exposure (fail closed)"
+      exit 1
+    fi
+    if [ "$recorded" != "$live" ]; then
+      log "DRIFT: recorded '$recorded' != live '$live'; reconcile before trusting records"
+      exit 1
     fi
     nft list chain inet falcon_filter input | head -4
     iptables -S DOCKER-USER
