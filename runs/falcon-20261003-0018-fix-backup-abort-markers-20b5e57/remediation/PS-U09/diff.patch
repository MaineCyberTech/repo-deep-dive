+#!/usr/bin/env bash
+# Fixture test for automation/validation/resolve_evidence_path.py (INV-P3-001).
+# Proves: host-absolute falcon-build and legacy monitoring-build paths resolve to
+# the repo-relative capture; already-relative paths are unchanged; --package maps
+# to the review-package copy; --root verifies presence; junk fails closed.
+# Offline; fixture tree only.
+# Usage: bash automation/validation/tests/resolve_evidence_path_test.sh
+set -u
+ROOT="$(cd "$(dirname "$(dirname "$(dirname "$(dirname "$0")")")")" && pwd)"
+RESOLVE="$ROOT/automation/validation/resolve_evidence_path.py"
+mkdir -p /tmp/opencode
+WORK="$(mktemp -d /tmp/opencode/resolve-evidence-path-test-XXXXXX)"
+trap 'rm -rf "$WORK"' EXIT
+
+CHECKS=0 FAILS=0
+check() { # check <desc> <expected> <actual>
+  CHECKS=$((CHECKS + 1))
+  if [ "$2" != "$3" ]; then
+    echo "FAIL: $1 (expected '$2', got '$3')"
+    FAILS=$((FAILS + 1))
+  fi
+}
+contains() { # contains <desc> <needle> <haystack>
+  CHECKS=$((CHECKS + 1))
+  case "$3" in
+    *"$2"*) : ;;
+    *) echo "FAIL: $1 (missing '$2')"; FAILS=$((FAILS + 1)) ;;
+  esac
+}
+
+# fixture tree with both evidence/ and review-package/ copies
+mkdir -p "$WORK/evidence/raw/G" "$WORK/review-package/evidence/raw/G"
+printf 'x\n' > "$WORK/evidence/raw/G/one.out"
+printf 'x\n' > "$WORK/review-package/evidence/raw/G/one.out"
+
+# --- falcon-build absolute path ----------------------------------------------------
+out="$(python3 "$RESOLVE" "/home/user/falcon-build/evidence/raw/G/one.out")"; rc=$?
+check "falcon-build exit" "0" "$rc"
+check "falcon-build resolves" "evidence/raw/G/one.out" "$out"
+
+# --- legacy monitoring-build absolute path -----------------------------------------
+out="$(python3 "$RESOLVE" "/home/user/monitoring-build/evidence/raw/G/one.out")"; rc=$?
+check "legacy absolute exit" "0" "$rc"
+check "legacy absolute resolves" "evidence/raw/G/one.out" "$out"
+
+# --- legacy relative index path ----------------------------------------------------
+out="$(python3 "$RESOLVE" "../monitoring-build/evidence/raw/G/one.out")"; rc=$?
+check "legacy relative exit" "0" "$rc"
+check "legacy relative resolves" "evidence/raw/G/one.out" "$out"
+
+# --- already repo-relative ---------------------------------------------------------
+out="$(python3 "$RESOLVE" "evidence/raw/G/one.out")"; rc=$?
+check "relative exit" "0" "$rc"
+check "relative unchanged" "evidence/raw/G/one.out" "$out"
+
+# --- windows separators normalise --------------------------------------------------
+out="$(python3 "$RESOLVE" 'C:\home\user\falcon-build\evidence\raw\G\one.out')"; rc=$?
+check "windows path exit" "0" "$rc"
+check "windows path resolves" "evidence/raw/G/one.out" "$out"
+
+# --- --package maps to the review-package copy -------------------------------------
+out="$(python3 "$RESOLVE" "/home/user/falcon-build/evidence/raw/G/one.out" --package)"; rc=$?
+check "package exit" "0" "$rc"
+check "package resolves" "review-package/evidence/raw/G/one.out" "$out"
+
+# --- --root verifies presence ------------------------------------------------------
+python3 "$RESOLVE" "/home/user/falcon-build/evidence/raw/G/one.out" --root "$WORK" >/dev/null 2>&1
+check "present under --root exit" "0" "$?"
+
+python3 "$RESOLVE" "/home/user/falcon-build/evidence/raw/G/absent.out" --root "$WORK" >/dev/null 2>&1
+check "absent under --root exit" "1" "$?"
+
+# --- unresolvable fails closed -----------------------------------------------------
+out="$(python3 "$RESOLVE" "/etc/passwd" 2>&1)"; rc=$?
+check "unresolvable exit" "1" "$rc"
+contains "unresolvable message" "UNRESOLVED" "$out"
+
+# --- json output -------------------------------------------------------------------
+out="$(python3 "$RESOLVE" "/home/user/falcon-build/evidence/raw/G/one.out" --root "$WORK" --json)"
+check "json exit" "0" "$?"
+contains "json resolved field" '"resolved": "evidence/raw/G/one.out"' "$out"
+contains "json exists field" '"exists": true' "$out"
+
+echo "resolve_evidence_path: $((CHECKS - FAILS))/$CHECKS checks passed"
+[ "$FAILS" -eq 0 ] || exit 1
+echo "PASS resolve_evidence_path"
+exit 0
