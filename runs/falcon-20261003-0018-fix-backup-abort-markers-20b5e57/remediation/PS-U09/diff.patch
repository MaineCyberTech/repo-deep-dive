index 0000000..b8060aa
--- /dev/null
+++ b/automation/validation/tests/generated_drift_check_test.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+# Fixture test for automation/validation/check_generated_drift.py (INV-P2-001).
+# Proves: a generated tree whose bytes match its committed manifest passes; a
+# tampered file fails; a missing file fails; an unparseable manifest fails closed.
+# Offline; fixture trees only.
+# Usage: bash automation/validation/tests/generated_drift_check_test.sh
+set -u
+ROOT="$(cd "$(dirname "$(dirname "$(dirname "$(dirname "$0")")")")" && pwd)"
+CHECK="$ROOT/automation/validation/check_generated_drift.py"
+mkdir -p /tmp/opencode
+WORK="$(mktemp -d /tmp/opencode/generated-drift-check-test-XXXXXX)"
+trap 'rm -rf "$WORK"' EXIT
+
+CHECKS=0 FAILS=0
+check() { # check <desc> <expected> <actual>
+  CHECKS=$((CHECKS + 1))
+  if [ "$2" != "$3" ]; then
+    echo "FAIL: $1 (expected '$2', got '$3')"
+    FAILS=$((FAILS + 1))
+  fi
+}
+contains() { # contains <desc> <needle> <haystack>
+  CHECKS=$((CHECKS + 1))
+  case "$3" in
+    *"$2"*) : ;;
+    *) echo "FAIL: $1 (missing '$2')"; FAILS=$((FAILS + 1)) ;;
+  esac
+}
+
+make_tree() { # make_tree <dir> ; writes one capture and its manifest
+  local dir="$1"
+  mkdir -p "$dir/evidence/raw/G"
+  printf 'capture fixture\n' > "$dir/evidence/raw/G/one.out"
+  local sha
+  sha="$(sha256sum "$dir/evidence/raw/G/one.out" | awk '{print $1}')"
+  printf '%s  evidence/raw/G/one.out\n' "$sha" > "$dir/evidence/MANIFEST.sha256"
+}
+
+# --- fixture 1: manifest matches the tree -> pass ---------------------------------
+OK="$WORK/ok"
+make_tree "$OK"
+out="$(python3 "$CHECK" --root "$OK")"; rc=$?
+check "consistent fixture exit code" "0" "$rc"
+contains "consistent fixture reports PASS" "PASS generated_drift" "$out"
+
+# --- fixture 2: tampered file -> drift -> fail ------------------------------------
+TAMPER="$WORK/tamper"
+make_tree "$TAMPER"
+printf 'tampered\n' >> "$TAMPER/evidence/raw/G/one.out"
+out="$(python3 "$CHECK" --root "$TAMPER")"; rc=$?
+check "tampered fixture exit code" "1" "$rc"
+contains "tampered fixture reports FAIL" "FAIL generated_drift" "$out"
+contains "tampered fixture names the drift" "drift evidence/raw/G/one.out" "$out"
+
+# --- fixture 3: missing file -> fail ----------------------------------------------
+MISSING="$WORK/missing"
+make_tree "$MISSING"
+rm -f "$MISSING/evidence/raw/G/one.out"
+out="$(python3 "$CHECK" --root "$MISSING")"; rc=$?
+check "missing file exit code" "1" "$rc"
+contains "missing file is named" "missing file evidence/raw/G/one.out" "$out"
+
+# --- fixture 4: unparseable manifest -> usage error (fail closed) ------------------
+BAD="$WORK/bad"
+mkdir -p "$BAD/evidence"
+printf 'not-a-manifest-line\n' > "$BAD/evidence/MANIFEST.sha256"
+out="$(python3 "$CHECK" --root "$BAD" 2>&1)"; rc=$?
+check "malformed manifest exit code" "2" "$rc"
+
+# --- fixture 5: missing manifest -> parse error is reported as drift -------------
+NOMAN="$WORK/noman"
+mkdir -p "$NOMAN/evidence"
+out="$(python3 "$CHECK" --root "$NOMAN")"; rc=$?
+check "missing manifest exit code" "1" "$rc"
+contains "missing manifest is named" "manifest missing: evidence/MANIFEST.sha256" "$out"
+
+echo "generated_drift_check: $((CHECKS - FAILS))/$CHECKS checks passed"
+[ "$FAILS" -eq 0 ] || exit 1
+echo "PASS generated_drift_check"
+exit 0
