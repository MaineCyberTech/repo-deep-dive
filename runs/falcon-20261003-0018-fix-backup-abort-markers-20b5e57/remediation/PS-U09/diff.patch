diff --git a/automation/validation/check_generated_drift.py b/automation/validation/check_generated_drift.py
new file mode 100644
index 0000000..e8f50d4
--- /dev/null
+++ b/automation/validation/check_generated_drift.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""Generated-artifact drift check (audit finding INV-P2-001).
+
+Most of this repository is generated/derived content (raw captures, the
+review-package copy, SBOM payloads, closeout digests). The regeneration scripts
+exist, but nothing recomputed the committed copies against their own manifests,
+so a stale or hand-edited generated artifact could silently contradict its
+source of truth.
+
+This check is deterministic and read-only. It recomputes the SHA-256 of every
+entry in each declared self-manifest and fails on a mismatch, a missing file, or
+an unparseable manifest. It does not regenerate anything and does not need the
+lab: it binds the committed bytes to the committed manifest.
+
+Declared manifests (the default set):
+  * ``evidence/MANIFEST.sha256`` -- the raw capture tree, the largest committed
+    generated tree (2,268 entries).
+
+``review-package/MANIFEST.sha256`` is intentionally not in the default set yet:
+its committed manifest is stale against HEAD (4 mismatches, 1 absent entry;
+``mct/config/examples/secrets.example.env``). Rebuilding the package and
+rebinding the digest is HYG-P0-001/PATCH-6 -- an owner/release action, recorded
+in REPOSITORY.md and the remediation PR, not silently curated here.
+
+Usage: check_generated_drift.py [--root DIR] [--manifest REL ...]
+Exit:  0 = no drift, 1 = drift found, 2 = usage or parse error (fail closed).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import os
+import re
+import sys
+
+DEFAULT_MANIFESTS = ("evidence/MANIFEST.sha256",)
+ENTRY_RE = re.compile(r"^([0-9a-fA-F]{64})[ \t]+\*?(.+?)\s*$")
+MAX_REPORTED = 20
+
+
+def sha256_file(path: str) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(65536), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def read_manifest(path: str) -> list[tuple[str, str]]:
+    entries: list[tuple[str, str]] = []
+    with open(path, encoding="utf-8") as fh:
+        for line in fh:
+            line = line.strip()
+            if not line or line.startswith("#"):
+                continue
+            match = ENTRY_RE.match(line)
+            if not match:
+                raise ValueError(f"unparseable manifest line: {line[:120]}")
+            entries.append((match.group(1).lower(), match.group(2)))
+    return entries
+
+
+def check(root: str, manifests: tuple[str, ...] | list[str]) -> int:
+    findings: list[str] = []
+    checked = 0
+    for rel_manifest in manifests:
+        manifest_path = os.path.join(root, *rel_manifest.split("/"))
+        if not os.path.isfile(manifest_path):
+            findings.append(f"manifest missing: {rel_manifest}")
+            continue
+        try:
+            entries = read_manifest(manifest_path)
+        except (OSError, ValueError) as exc:
+            print(f"ERROR: cannot read {rel_manifest}: {exc}", file=sys.stderr)
+            return 2
+        for declared, rel in entries:
+            checked += 1
+            target = os.path.join(root, *rel.split("/"))
+            if not os.path.isfile(target):
+                findings.append(f"{rel_manifest}: missing file {rel}")
+                continue
+            actual = sha256_file(target)
+            if actual != declared:
+                findings.append(
+                    f"{rel_manifest}: drift {rel} (declared={declared[:12]} actual={actual[:12]})")
+
+    if findings:
+        print("FAIL generated_drift")
+        for line in findings[:MAX_REPORTED]:
+            print(f"  {line}")
+        if len(findings) > MAX_REPORTED:
+            print(f"  ... and {len(findings) - MAX_REPORTED} more")
+        print(f"generated_drift: {len(findings)} drift finding(s) over {checked} manifest entries")
+        return 1
+    print(f"PASS generated_drift ({checked} entries match their committed manifests)")
+    return 0
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    here = os.path.dirname(os.path.abspath(__file__))
+    default_root = os.path.dirname(os.path.dirname(here))
+    parser.add_argument("--root", default=default_root)
+    parser.add_argument("--manifest", action="append", default=None,
+                        help="manifest path relative to --root (repeatable)")
+    args = parser.parse_args(argv)
+    manifests = tuple(args.manifest) if args.manifest else DEFAULT_MANIFESTS
+    return check(os.path.abspath(args.root), manifests)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/automation/validation/resolve_evidence_path.py b/automation/validation/resolve_evidence_path.py
new file mode 100644
index 0000000..c30415b
--- /dev/null
+++ b/automation/validation/resolve_evidence_path.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Resolve a recorded capture path to its location in a clone (INV-P3-001).
+
+Raw evidence metadata (``evidence/raw/**/*.meta.json``) records absolute
+artifact paths on the capture host, e.g.
+``/home/user/falcon-build/evidence/raw/G/one.out``, and ``ledgers/evidence_index.csv``
+keeps 264 legacy rows under ``../monitoring-build/evidence/...``. Neither path
+exists in a fresh clone, so off-host reviewers had to rewrite the prefix by hand.
+
+This resolver maps any of those recorded forms to the repository-relative
+``evidence/raw/...`` path (and, with ``--package``, to the
+``review-package/evidence/raw/...`` copy) so review is one command:
+
+  * ``<prefix>/falcon-build/evidence/raw/...``      -> ``evidence/raw/...``
+  * ``<prefix>/monitoring-build/evidence/raw/...``  -> ``evidence/raw/...``
+  * ``../monitoring-build/evidence/raw/...``        -> ``evidence/raw/...``
+  * already-relative ``evidence/raw/...``           -> unchanged
+  * already-relative ``review-package/evidence/raw/...`` -> unchanged
+
+With ``--root`` the resolved path is checked to exist in the clone: exit 1 if it
+does not, so a broken resolver result is caught rather than printed as fact.
+
+Usage: resolve_evidence_path.py <recorded-path> [--root DIR] [--package] [--json]
+Exit:  0 = resolved (and present when --root), 1 = unresolvable or absent,
+       2 = usage error.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+
+MARKER = "evidence/raw/"
+PACKAGE_PREFIX = "review-package/"
+
+
+def normalise(path: str) -> str:
+    return path.replace("\\", "/")
+
+
+def resolve(recorded: str, package: bool = False) -> str | None:
+    """Return the repo-relative capture path for a recorded artifact path."""
+    norm = normalise(recorded).strip()
+    if not norm:
+        return None
+    # Already repo-relative (the modern evidence_index.csv form).
+    if norm.startswith(MARKER):
+        rel = norm
+    elif norm.startswith(PACKAGE_PREFIX + MARKER):
+        rel = norm[len(PACKAGE_PREFIX):]
+    else:
+        idx = norm.find(MARKER)
+        if idx < 0:
+            return None
+        rel = MARKER + norm[idx + len(MARKER):]
+    return PACKAGE_PREFIX + rel if package else rel
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("recorded", help="path recorded in metadata or the evidence index")
+    parser.add_argument("--root", default=None,
+                        help="clone root; verify the resolved path exists under it")
+    parser.add_argument("--package", action="store_true",
+                        help="map to the review-package/ copy instead of the evidence/ tree")
+    parser.add_argument("--json", action="store_true", help="emit JSON")
+    args = parser.parse_args(argv)
+
+    rel = resolve(args.recorded, package=args.package)
+    if rel is None:
+        if args.json:
+            print(json.dumps({"recorded": args.recorded, "resolved": None, "exists": None}))
+        else:
+            print(f"UNRESOLVED: {args.recorded} (no '{MARKER}' component)", file=sys.stderr)
+        return 1
+
+    exists = None
+    if args.root is not None:
+        root = os.path.abspath(args.root)
+        exists = os.path.isfile(os.path.join(root, *rel.split("/")))
+
+    if args.json:
+        print(json.dumps({"recorded": args.recorded, "resolved": rel, "exists": exists}))
+    else:
+        print(rel)
+        if args.root is not None and not exists:
+            print(f"MISSING: {rel} not present under {args.root}", file=sys.stderr)
+    if args.root is not None and not exists:
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
