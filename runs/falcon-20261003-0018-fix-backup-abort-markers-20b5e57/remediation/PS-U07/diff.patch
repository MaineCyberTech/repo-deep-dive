diff --git a/automation/validation/r2_cold_copy.sh b/automation/validation/r2_cold_copy.sh
index 10c5939..3be57f2 100755
--- a/automation/validation/r2_cold_copy.sh
+++ b/automation/validation/r2_cold_copy.sh
@@ -43,6 +43,12 @@
 # COLD_COPY_MARKER_DIR, COLD_COPY_METRICS_FILE, COLD_COPY_NOW_EPOCH (tests).
 set -u
 
+# FINAL-P1-001 / ARCH-P2-005: SIGTERM/SIGINT writes a durable abort marker (shared helper)
+# and exits 130, so an interrupted cold-copy run is visible to the next run instead of looking
+# current; the marker is cleared only on a clean (exit 0) completion, in main below.
+# shellcheck source=lib/abort.sh
+. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/abort.sh"
+
 SEC="${COLD_COPY_SECRETS_DIR:-/srv/falcon/secrets}"
 OS="${COLD_COPY_CONTAINER:-falcon-central-opensearch-1}"
 MARKER_DIR="${COLD_COPY_MARKER_DIR:-/srv/falcon/backups/cold-copy}"
@@ -211,8 +217,22 @@ delete_stale_snapshot() {
   return 1
 }
 
+# EXIT handler (FINAL-P1-001 / ARCH-P2-005): publish metrics as before, and clear the abort
+# marker only on a clean (exit 0) completion. A non-zero exit leaves the marker in place.
+r2_cold_copy_exit() {
+  local rc=$?
+  if [ "$DRY_RUN" != "1" ]; then publish_metrics || true; fi
+  if [ "$rc" -eq 0 ]; then clear_abort_marker "r2-cold-copy"; fi
+}
+
 main() {
-  trap 'if [ "$DRY_RUN" != "1" ]; then publish_metrics || true; fi' EXIT
+  # FINAL-P1-001 / ARCH-P2-005: write the abort marker on TERM/INT; clear it only on a clean
+  # (exit 0) completion. A non-zero exit leaves the marker so the next run re-verifies state.
+  install_abort_trap "r2-cold-copy"
+  if abort_marker_present "r2-cold-copy"; then
+    log "WARN: a previous cold-copy run aborted (marker present); re-verifying and continuing"
+  fi
+  trap 'r2_cold_copy_exit' EXIT
   if [ "$(id -u)" -ne 0 ]; then
     log "must run as root (installed by bootstrap/92-cold-copy.sh)"
     exit 1
