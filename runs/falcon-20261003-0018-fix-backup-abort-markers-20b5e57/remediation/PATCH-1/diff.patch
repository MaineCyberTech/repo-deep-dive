diff --git a/bootstrap/lib.sh b/bootstrap/lib.sh
index 8992372..ba53c12 100755
--- a/bootstrap/lib.sh
+++ b/bootstrap/lib.sh
@@ -67,3 +67,34 @@ backup_file_once() {
 # not source this file (disk_guard.sh, restore_rehearsal.sh) use the same implementation.
 # shellcheck source=../automation/validation/lib/abort.sh
 . "$REPO_ROOT/automation/validation/lib/abort.sh"
+
+# ARCH-P1-002: the signal trap above only covers SIGTERM/SIGINT. A run that fails via a
+# normal non-zero exit (a failed snapshot, an uncaught error) previously wrote no marker,
+# so the next run could not tell it apart from a clean state. `install_failure_trap` adds an
+# EXIT trap that writes the marker on *any* exit that was not explicitly marked clean;
+# `mark_clean_exit` is the only way to suppress it. A job that installs this trap must call
+# `clear_abort_marker "<job>"` and then `mark_clean_exit "<job>"` as its final actions.
+install_failure_trap() {
+  local name="$1"
+  FALCON_ABORT_JOB="$name"
+  FALCON_ABORT_COMPLETE=0
+  # shellcheck disable=SC2064
+  trap '_on_unclean_exit' EXIT
+}
+
+mark_clean_exit() {
+  FALCON_ABORT_COMPLETE=1
+}
+
+_on_unclean_exit() {
+  local rc=$?
+  local marker
+  if [ "${FALCON_ABORT_COMPLETE:-0}" != "1" ]; then
+    marker="$(abort_marker_path "${FALCON_ABORT_JOB:-job}")"
+    mkdir -p "$FALCON_ABORT_DIR" 2>/dev/null || true
+    printf 'incomplete_utc=%s job=%s pid=%s rc=%s\n' \
+      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${FALCON_ABORT_JOB:-job}" "$$" "$rc" > "$marker" 2>/dev/null || true
+    _abort_log "incomplete run (rc=$rc); wrote marker $marker (next run will re-verify)"
+  fi
+  return "$rc"
+}
