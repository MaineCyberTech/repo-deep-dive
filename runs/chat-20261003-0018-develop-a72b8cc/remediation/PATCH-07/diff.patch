@@ -225,8 +225,34 @@ jobs:
           node-version: 22
           cache: pnpm
       - run: pnpm install --frozen-lockfile
-      - name: Run pnpm audit
-        run: pnpm audit --prod --audit-level=high || true
+      - name: Run pnpm audit (blocking; time-boxed exceptions)
+        # Blocking: fail on any HIGH/CRITICAL advisory not in .pnpm-audit-exceptions.json,
+        # and on the entire exception list once it expires. Do not restore `|| true`.
+        run: |
+          set -euo pipefail
+          corepack pnpm audit --prod --json > audit.json 2>/dev/null || true
+          node - <<'NODE'
+          const fs = require('fs');
+          const report = JSON.parse(fs.readFileSync('audit.json', 'utf8'));
+          const exceptions = JSON.parse(fs.readFileSync('.pnpm-audit-exceptions.json', 'utf8'));
+          const expiry = Date.parse(`${exceptions.expires}T23:59:59Z`);
+          if (Number.isNaN(expiry) || Date.now() > expiry) {
+            console.error(`audit exceptions expired on ${exceptions.expires}; renew or fix the listed advisories`);
+            process.exit(1);
+          }
+          const allow = new Set(exceptions.ignoreGhsas || []);
+          const blocking = [];
+          for (const adv of Object.values(report.advisories || {})) {
+            if (adv.severity !== 'high' && adv.severity !== 'critical') continue;
+            const id = adv.github_advisory_id || `npm-${adv.id}`;
+            if (!allow.has(id)) blocking.push(`${adv.severity} ${id} ${adv.module_name}: ${adv.title}`);
+          }
+          if (blocking.length) {
+            console.error('Un-allowlisted HIGH/CRITICAL advisories:\n' + blocking.join('\n'));
+            process.exit(1);
+          }
+          console.log(`pnpm audit: no HIGH/CRITICAL advisories outside the ${allow.size}-entry time-boxed exception list`);
+          NODE
       - name: Run Trivy vulnerability scanner
         uses: aquasecurity/trivy-action@a9c7b0f06e461e9d4b4d1711f154ee024b8d7ab8 # v0.36.0
         with:
