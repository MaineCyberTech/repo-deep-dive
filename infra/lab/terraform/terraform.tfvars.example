# Copy to terraform.tfvars (gitignored) and fill in. NEVER commit real tokens or
# private keys. The API token may instead come from PROXMOX_VE_API_TOKEN.

proxmox_endpoint = "https://172.23.128.50:8006/"
proxmox_node     = "pve"
# proxmox_api_token = "terraform@pve!lab=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

datastore_id         = "local-lvm"
snippet_datastore_id = "local"
bridge               = "vmbr0"
gateway              = "172.23.128.1"

# VMIDs of the templates this config clones (find with: pct list / qm list).
ct_template_vm_id = 9000
vm_template_vm_id = 9001

guest_username = "labadmin"
# Public keys only. Supply out of band, e.g. from a local file:
# ssh_public_keys = [file("~/.ssh/lab_ed25519.pub")]
ssh_public_keys = []

ci_runner_ipv4   = "172.23.128.51/24"
edge_builder_ipv4 = "172.23.128.52/24"
