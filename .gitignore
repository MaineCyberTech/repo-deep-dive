# OS / editor junk
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/

# Machine-local model / environment pins. `opencode.json` is intentionally
# excluded from PACK_DIGEST.txt (see tools/pack_digest.sh); once untracked it
# must stay out of the pack.
opencode.json

# Self-test output captured by the Pack tests workflow (and locally).
self_test.log

# Scratch output from tools/deterministic_checks.py (default -o deterministic-out)
deterministic-out/

# Lab audit overlay WireGuard material — private keys and client configs are secrets
# and must never be committed (generated by tools/lab-vpn/lab-audit-add-agent.sh).
lab-audit-*.conf
*.wgkey

# Python bytecode
__pycache__/
*.pyc

# Terraform (infra/lab/terraform) — local state, plans and secrets are never committed.
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
crash.log
