{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/repo-deep-dive/schemas/findings.schema.json",
  "title": "repo-deep-dive findings.json",
  "description": "Machine-readable findings for one audit run, as written by tools/collect_findings.py --write. Finding rows mirror the AREA-Px-NNN markdown format; register fields (owner/target/status/note) come from follow_up_register.md when present.",
  "type": "object",
  "required": ["run", "generated", "sourceReports", "counts", "findings"],
  "properties": {
    "run": { "type": "string" },
    "generated": { "type": "string" },
    "sourceReports": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of source reports scanned for findings (e.g. tools/collect_findings.py emits len(reports))."
    },
    "counts": {
      "type": "object",
      "required": ["total", "bySeverity", "byArea"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "bySeverity": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byArea": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "report", "line"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-P[0-3]-[0-9]{3}$"
          },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string", "minLength": 1 },
          "report": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "owner": { "type": "string" },
          "target": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["", "open", "partially-fixed", "verified-fixed", "still-open", "regressed", "owner-accepted"]
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
